{
  "name": "astronautical-apogee",
  "type": "module",
  "version": "0.3.0",
  "scripts": {
    "commit": "wireit",
    "deploy": "wireit",
    "dev": "astro dev",
    "build": "wireit",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "screenshot:business-card": "node scripts/screenshot-business-card.js",
    "update:lighthouse-badges": "node scripts/update-lighthouse-badges.js",
    "prepare": "husky",
    "lighthouse": "npx lighthouse https://andrewnoblet.com --chrome-flags='--headless' --output json --output-path reports/lighthouse.json --quiet",
    "test": "web-test-runner --playwright --node-resolve",
    "test:watch": "web-test-runner --playwright --node-resolve --watch",
    "test:coverage": "web-test-runner --playwright --node-resolve --coverage",
    "test:unit": "web-test-runner --playwright --node-resolve --group unit",
    "test:integration": "web-test-runner --playwright --node-resolve --group integration",
    "test:e2e": "web-test-runner --playwright --node-resolve --group e2e",
    "test:accessibility": "web-test-runner --playwright --node-resolve --group accessibility",
    "test:performance": "web-test-runner --playwright --node-resolve --group performance",
    "test:visual": "web-test-runner --playwright --node-resolve --group visual",
    "test:ci": "web-test-runner --playwright --node-resolve --coverage --reporter json"
  },
  "dependencies": {
    "@anoblet/mixins": "github:anoblet/mixins",
    "@astrojs/node": "^9.4.0",
    "astro": "^5.12.0",
    "lit": "^3.3.0",
    "playwright": "^1.54.1"
  },
  "lint-staged": {
    "*.{js,mjs,ts,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ],
    "genaisrc/**": []
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@esm-bundle/chai": "4.3.4-fix.0",
    "@fontsource/noto-sans": "^5.2.7",
    "@fontsource/poppins": "^5.2.6",
    "@open-wc/testing": "^4.0.0",
    "@open-wc/testing-helpers": "^3.0.1",
    "@playwright/test": "^1.54.1",
    "@typescript-eslint/eslint-plugin": "^8.34.0",
    "@typescript-eslint/parser": "^8.34.0",
    "@web/dev-server": "^0.4.6",
    "@web/test-runner": "^0.20.2",
    "@web/test-runner-mocha": "^0.9.0",
    "@web/test-runner-playwright": "^0.11.1",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-lit": "^2.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.5.3",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.34.2",
    "wait-on": "^8.0.4",
    "wireit": "^0.14.12",
    "wrangler": "^4.14.1"
  },
  "wireit": {
    "build": {
      "command": "astro build"
    },
    "commit": {
      "command": "pnpm dlx genaiscript run commit"
    },
    "deploy": {
      "command": "wrangler deploy",
      "dependencies": [
        "build"
      ]
    }
  }
}
