{
  "name": "astronautical-apogee",
  "type": "module",
  "version": "0.3.0",
  "scripts": {
    "commit": "wireit",
    "deploy": "wireit",
    "dev": "astro dev",
    "build": "wireit",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "screenshot:business-card": "node scripts/screenshot-business-card.js",
    "update:lighthouse-badges": "node scripts/update-lighthouse-badges.js",
    "prepare": "husky",
    "lighthouse": "npx lighthouse https://andrewnoblet.com --chrome-flags='--headless' --output json --output-path reports/lighthouse.json --quiet"
  },
  "dependencies": {
    "@analogjs/astro-angular": "^2.7.1",
    "@angular/animations": "^22.1.4",
    "@angular/cdk": "^22.1.4",
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/forms": "^22.1.4",
    "@angular/material": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@angular/platform-server": "^22.1.4",
    "@anoblet/mixins": "github:anoblet/mixins",
    "@astrojs/node": "^11.1.4",
    "astro": "^7.2.9",
    "lit": "^3.3.0",
    "playwright": "^1.54.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "lint-staged": {
    "*.{js,mjs,ts,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ],
    "genaisrc/**": []
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/compiler-cli": "^22.1.4",
    "@angular/language-service": "^22.1.4",
    "@eslint/js": "^9.29.0",
    "@fontsource/noto-sans": "^5.2.7",
    "@fontsource/poppins": "^5.2.6",
    "@playwright/test": "^1.54.1",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-lit": "^2.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.5.3",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.34.2",
    "typescript": "~6.0.3",
    "wait-on": "^8.0.4",
    "wireit": "^0.14.12",
    "wrangler": "^4.14.1"
  },
  "wireit": {
    "build": {
      "command": "astro build"
    },
    "commit": {
      "command": "pnpm dlx genaiscript run commit"
    },
    "deploy": {
      "command": "wrangler deploy",
      "dependencies": [
        "build"
      ]
    }
  }
}
