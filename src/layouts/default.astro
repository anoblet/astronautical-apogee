---
import '../styles/colors.css';
import '@styles/fonts.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Astro description' } = Astro.props;

import { ClientRouter } from 'astro:transitions';
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google Tag Manager -->
    <script>
      (function (w, d, s, l, i) {
        (w as any)[l] = (w as any)[l] || [];
        (w as any)[l].push({
          'gtm.start': new Date().getTime(),
          event: 'gtm.js',
        });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s) as HTMLScriptElement,
          dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        if (f && f.parentNode) {
          f.parentNode.insertBefore(j, f);
        }
      })(window, document, 'script', 'dataLayer', 'GTM-N2FTVHQC');
    </script>
    <!-- End Google Tag Manager -->

    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-N2FTVHQC"
        height="0"
        width="0"
        class="visually-hidden"></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->
    <Header />
    <main id="main-content" class="column flex gap">
      <slot />
    </main>
    <Footer />
    <contact-component></contact-component>
    <theme-toggle></theme-toggle>
    <style>
      .skip-link {
        background: var(--color-accent-500, #19f9d8);
        color: var(--color-neutral-900, #333);
        left: 0;
        padding: 0.75rem 1.5rem;
        position: absolute;
        top: -100px;
        z-index: 1000;
        transition: top 0.2s;
        text-decoration: none;
        font-weight: 600;
        border-radius: 0 0 0.5rem 0.5rem;
      }
      .skip-link:focus {
        top: 0;
        outline: 2px solid var(--color-accent-500, #19f9d8);
      }
    </style>
  </body>
</html>
<style>
  @view-transition {
    navigation: auto;
  }

  * {
  }

  body {
    min-height: 100vh;
    /* opacity: 1; */
    /* transition: opacity 0.2s ease-in-out; */

    &:has(*:not(:defined)) {
      /* opacity: 0; */
    }
  }

  main {
    align-items: center;
    flex: 1;
    padding: 5rem 1rem;

    p {
      align-items: initial;
    }
  }
</style>
<script>
  import '@components/contact';
  import '@components/social';
  import '@components/theme/toggle';
  import { globalStyles } from '@styles/global';
  import media from '@utility/media';
  import { applyStoredTheme } from '@utility/theme';

  media.subscribe((media: string) => {
    document.body.setAttribute('data-media', media);
  });

  // Apply global styles
  if (globalStyles.styleSheet) {
    document.adoptedStyleSheets = [
      ...document.adoptedStyleSheets,
      globalStyles.styleSheet,
    ];
  } else {
    console.error('Global styles not loaded');
  }

  applyStoredTheme();

  document.addEventListener('astro:after-swap', applyStoredTheme);
</script>
