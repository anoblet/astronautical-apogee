---
import '../styles/colors.css';
import '@styles/fonts.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Astro description' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ViewTransitions />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Header />
    <main id="main-content" class="column flex gap">
      <slot />
    </main>
    <Footer />
    <contact-component></contact-component>
    <theme-toggle></theme-toggle>
    <style>
      .skip-link {
        background: var(--color-accent-500, #19f9d8);
        color: var(--color-neutral-900, #333);
        left: 0;
        padding: 0.75rem 1.5rem;
        position: absolute;
        top: -100px;
        z-index: 1000;
        transition: top 0.2s;
        text-decoration: none;
        font-weight: 600;
        border-radius: 0 0 0.5rem 0.5rem;
      }
      .skip-link:focus {
        top: 0;
        outline: 2px solid var(--color-accent-500, #19f9d8);
      }
    </style>
  </body>
</html>
<style>
  * {
  }

  body {
    min-height: 100vh;
  }

  main {
    align-items: center;
    flex: 1;
    padding: 5rem 1rem;

    p {
      align-items: initial;
    }
  }
</style>
<script>
  import '@components/contact';
  import '@components/social';
  import '@components/theme/toggle';
  import { globalStyles } from '@styles/global';
  import { applyStoredTheme } from '@utility/theme';

  // Apply global styles
  if (globalStyles.styleSheet) {
    document.adoptedStyleSheets = [
      ...document.adoptedStyleSheets,
      globalStyles.styleSheet,
    ];
  } else {
    console.error('Global styles not loaded');
  }

  applyStoredTheme();

  document.addEventListener('astro:after-swap', applyStoredTheme);
</script>
