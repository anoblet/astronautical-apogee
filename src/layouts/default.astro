---
import '../styles/colors.css';
import '@styles/fonts.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Astro description' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ViewTransitions />
  </head>
  <body>
    <div id="interstitial" class="interstitial">
      <div class="interstitial-content">
        <svg
          class="interstitial-planet"
          xmlns="http://www.w3.org/2000/svg"
          height="6rem"
          viewBox="0 -960 960 960"
          width="6rem"
        >
          <path
            d="M449-539q21 0 35.5-14.5T499-589q0-21-14.5-35.5T449-639q-21 0-35.5 14.5T399-589q0 21 14.5 35.5T449-539ZM822-80q-42 0-113-35t-152-95q-19 5-38.5 7.5T479-200q-117 0-198-81t-81-198q0-20 3-40t8-39q-59-81-94.5-151.5T81-822q0-27 15-42.5t41-15.5q26 0 67.5 18T319-801q-21 11-39 23t-35 26q-19-11-37-19t-38-17q18 38 38.5 74t43.5 71q38-54 97-85t130-31q117 0 198.5 81.5T759-479q0 71-31.5 130T642-252q35 23 71.5 44t74.5 38q-8-19-16.5-37T752-244q15-17 27-36t22-39q46 78 62.5 116.5T880-138q0 29-16 43.5T822-80ZM549-359q17 0 28.5-11.5T589-399q0-17-11.5-28.5T549-439q-17 0-28.5 11.5T509-399q0 17 11.5 28.5T549-359Zm50-140q13 0 21.5-8.5T629-529q0-13-8.5-21.5T599-559q-13 0-21.5 8.5T569-529q0 13 8.5 21.5T599-499ZM468-281q-51-44-98-91t-90-98q2 38 17 71.5t41 59.5q26 26 59 41t71 17Zm103-21q48-25 78-72.5T679-480q0-83-58.5-141T479-679q-58 0-105 30t-72 78q57 76 125 144t144 125Zm-197-73Zm117-116Z"
          ></path>
        </svg>
      </div>
    </div>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Header />
    <main id="main-content" class="column flex gap hidden-until-loaded">
      <slot />
    </main>
    <Footer />
    <contact-component></contact-component>
    <theme-toggle></theme-toggle>
    <style>
      .skip-link {
        background: var(--color-accent-500, #19f9d8);
        color: var(--color-neutral-900, #333);
        left: 0;
        padding: 0.75rem 1.5rem;
        position: absolute;
        top: -100px;
        z-index: 1000;
        transition: top 0.2s;
        text-decoration: none;
        font-weight: 600;
        border-radius: 0 0 0.5rem 0.5rem;
      }
      .skip-link:focus {
        top: 0;
        outline: 2px solid var(--color-accent-500, #19f9d8);
      }
    </style>
  </body>
</html>
<style>
  * {
  }

  body {
    min-height: 100vh;
  }

  /* Interstitial is visible by default with immediate dark theme styling */
  #interstitial {
    opacity: 1;
    pointer-events: auto;
    transition: opacity 0.3s ease-in-out;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: oklch(0.205 0 0); /* --color-neutral-900 dark theme */
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #interstitial .interstitial-content {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #interstitial .interstitial-planet {
    fill: oklch(0.91 0.096 180.426); /* --color-teal-200 dark theme */
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.2);
    }
  }

  /* Main content is hidden by default */
  .hidden-until-loaded {
    opacity: 0;
    transition: opacity 0.3s ease-in-out;
  }

  /* Hide interstitial and show main content when all custom elements are defined */
  body:not(:has(*:not(:defined))) #interstitial {
    opacity: 0;
    pointer-events: none;
  }

  body:not(:has(*:not(:defined))) .hidden-until-loaded {
    opacity: 1;
  }

  main {
    align-items: center;
    flex: 1;
    padding: 5rem 1rem;

    p {
      align-items: initial;
    }
  }
</style>
<script>
  import '@components/contact';
  import '@components/social';
  import '@components/theme/toggle';
  import { globalStyles } from '@styles/global';
  import { applyStoredTheme } from '@utility/theme';
  import { initializePreloader } from '@utility/preloader';

  // Apply global styles
  if (globalStyles.styleSheet) {
    document.adoptedStyleSheets = [
      ...document.adoptedStyleSheets,
      globalStyles.styleSheet,
    ];
  } else {
    console.error('Global styles not loaded');
  }

  applyStoredTheme();

  document.addEventListener('astro:after-swap', applyStoredTheme);

  // Initialize URL preloader
  initializePreloader();

  // Interstitial management with fallback for browsers that don't support :has()
  function checkCustomElements() {
    const customElementTags = ['contact-component', 'theme-toggle'];
    const allDefined = customElementTags.every(tag => customElements.get(tag));
    const interstitial = document.getElementById('interstitial') as HTMLElement;
    const hiddenContent = document.querySelector(
      '.hidden-until-loaded'
    ) as HTMLElement;

    if (allDefined) {
      // All custom elements are defined, hide interstitial and show content
      if (interstitial) {
        interstitial.style.opacity = '0';
        interstitial.style.pointerEvents = 'none';
      }
      if (hiddenContent) {
        hiddenContent.style.opacity = '1';
      }
      return true;
    }
    return false;
  }

  // Check immediately
  if (!checkCustomElements()) {
    // Poll for custom element definition
    const checkInterval = setInterval(() => {
      if (checkCustomElements()) {
        clearInterval(checkInterval);
      }
    }, 50);

    // Cleanup after maximum wait time
    setTimeout(() => {
      clearInterval(checkInterval);
      // Force show content after timeout
      const interstitial = document.getElementById(
        'interstitial'
      ) as HTMLElement;
      const hiddenContent = document.querySelector(
        '.hidden-until-loaded'
      ) as HTMLElement;
      if (interstitial) {
        interstitial.style.opacity = '0';
        interstitial.style.pointerEvents = 'none';
      }
      if (hiddenContent) {
        hiddenContent.style.opacity = '1';
      }
    }, 3000);
  }

  let analyticsActivated = false;
  const activateAnalytics = () => {
    if (analyticsActivated) return;
    analyticsActivated = true;
    const w = window as any;
    const d = document;
    const s = 'script';
    const l = 'dataLayer';
    const i = 'GTM-N2FTVHQC';
    w[l] = w[l] || [];
    w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
    const f = d.getElementsByTagName(s)[0];
    const j = d.createElement(s) as HTMLScriptElement;
    const dl = l != 'dataLayer' ? '&l=' + l : '';
    j.async = true;
    j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
    if (f && f.parentNode) f.parentNode.insertBefore(j, f);
  };

  const startIfConsented = () => {
    try {
      if (localStorage.getItem('analytics-consent') === 'granted') {
        if ('requestIdleCallback' in window)
          (window as any).requestIdleCallback(activateAnalytics);
        else setTimeout(activateAnalytics, 0);
        return true;
      }
    } catch {}
    return false;
  };

  const listeners = ['click', 'keydown', 'touchstart', 'scroll'] as const;
  const onInteract = () => {
    listeners.forEach(ev =>
      window.removeEventListener(
        ev,
        onInteract as any,
        { passive: true } as any
      )
    );
    activateAnalytics();
  };
  if (!startIfConsented()) {
    listeners.forEach(ev =>
      window.addEventListener(
        ev,
        onInteract as any,
        { once: true, passive: true } as any
      )
    );
  }
  (window as any).setAnalyticsConsent = (value: 'granted' | 'denied') => {
    try {
      localStorage.setItem('analytics-consent', value);
    } catch {}
    if (value === 'granted') onInteract();
  };
</script>
