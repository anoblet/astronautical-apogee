---
import CallToAction from './CallToAction.astro';
export interface Props {
  title: string;
  description: string;
  features: string[];
  price: string;
  buttonText: string;
  buttonHref: string;
}
const { title, description, features, price, buttonText, buttonHref } =
  Astro.props;
---

<card-component>
  <h2 class="font-size-1-5">{title}</h2>
  <p class="font-size-1-125">{description}</p>
  <ul class="list margin-bottom-2">
    {features.map(feature => <li>{feature}</li>)}
  </ul>
  <div class="font-size-2 font-weight-6 margin-bottom-2 text-align-center">
    {price}
  </div>
  <div class="flex justify-content-center">
    <CallToAction href={buttonHref}>{buttonText}</CallToAction>
  </div>
</card-component>

<script>
  import '@components/card';
</script>
