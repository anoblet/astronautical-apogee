---
import CallToAction from './CallToAction.astro';
export interface Props {
  title: string;
  description: string;
  features: string[];
  price: string;
  buttonText: string;
  buttonHref: string;
}
const { title, description, features, price, buttonText, buttonHref } =
  Astro.props;
const href =
  buttonHref === '/contact' ||
  buttonHref.startsWith('https://calendar.app.google/')
    ? `/contact?package=${encodeURIComponent(title)}`
    : buttonHref;
---

<article class="pricing-card">
  <h2>{title}</h2><p>{description}</p>
  <p class="price">
    {price}<span
      >{price.includes('/mo') ? 'Recurring service' : 'One-time package'}</span
    >
  </p>
  <ul>{features.map(feature => <li>{feature}</li>)}</ul>
  <CallToAction href={href}>{buttonText}</CallToAction>
</article>
<style>
  .pricing-card {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    border: 1px solid var(--card-border-color);
    border-radius: 0.5rem;
    padding: 2rem;
    background: color-mix(
      in srgb,
      var(--text-color) 3%,
      var(--body-background-color)
    );
    min-width: 0;
  }
  h2 {
    font-size: 1.4rem;
    color: var(--text-color);
    line-height: 1.3;
  }
  p {
    color: var(--hero-description-color);
  }
  ul {
    flex: 1;
  }
  .price {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 600;
    color: var(--a-color);
  }
  .price span {
    display: block;
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--hero-description-color);
    margin-top: 0.5rem;
  }
</style>
