<button
  class="theme-button"
  type="button"
  data-theme-toggle
  aria-label="Dark theme"
  aria-pressed="true"
  hidden>Theme</button
>
<style>
  .theme-button {
    justify-self: start;
    background: var(--button-background-color);
    color: var(--button-color);
    border: 1px solid var(--card-border-color);
    border-radius: 2rem;
    padding: 0.7rem 1rem;
    cursor: pointer;
    font: inherit;
    box-shadow: var(--box-shadow);
  }
</style>
<script>
  import { getTheme, selectTheme, subscribe } from '@utility/theme';
  subscribe(name => {
    const button = document.querySelector<HTMLButtonElement>(
      '[data-theme-toggle]'
    );
    if (button) {
      button.hidden = false;
      button.setAttribute('aria-pressed', String(name === 'dark'));
    }
  });
  document.addEventListener('click', event => {
    if ((event.target as Element).closest('[data-theme-toggle]'))
      selectTheme(getTheme().name === 'dark' ? 'light' : 'dark');
  });
</script>
