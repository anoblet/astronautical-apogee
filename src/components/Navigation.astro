---
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = (href: string) => (path === href ? 'page' : undefined);
const groups = [
  {
    title: 'Portfolio',
    href: '/portfolio',
    children: [
      ['Personal projects', '/portfolio/personal'],
      ['Professional work', '/portfolio/professional'],
    ],
  },
  {
    title: 'Services',
    href: '/services',
    children: [
      ['Design', '/services/design'],
      ['Hosting', '/services/hosting'],
      ['Consultation', '/services/consultation'],
      ['Social media', '/services/social'],
    ],
  },
];
---

<site-navigation>
  <nav aria-label="Main navigation">
    <a class="brand" href="/" aria-current={current('/')}
      >Andrew Noblet<span>Design & development</span></a
    >
    <details class="navigation-menu" open>
      <summary class="mobile-menu">Menu</summary>
      <div class="nav-links">
        {
          groups.map(group => (
            <div class="nav-group">
              <a href={group.href} aria-current={current(group.href)}>
                {group.title}
              </a>
              <details class="nav-disclosure">
                <summary
                  aria-label={`Show ${group.title.toLowerCase()} links`}
                />
                <div class="submenu">
                  {group.children.map(([label, href]) => (
                    <a href={href} aria-current={current(href)}>
                      {label}
                    </a>
                  ))}
                </div>
              </details>
            </div>
          ))
        }
        {
          ['Mentorship', 'Blog', 'About', 'Pricing'].map(label => (
            <a
              href={'/' + label.toLowerCase()}
              aria-current={current('/' + label.toLowerCase())}
            >
              {label}
            </a>
          ))
        }
        <a
          class="nav-contact"
          href="/contact"
          aria-current={current('/contact')}
          >Let’s talk <span aria-hidden="true">→</span></a
        >
      </div>
    </details>
  </nav>
</site-navigation>
<script is:inline>
  document.currentScript?.previousElementSibling
    ?.querySelector('.navigation-menu')
    ?.toggleAttribute('open', matchMedia('(min-width: 1024px)').matches);
</script>
<style>
  site-navigation {
    display: block;
  }
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    max-width: 1200px;
    margin: auto;
    padding: 1rem;
    background: var(--navigation-background-color);
  }
  a,
  summary {
    color: var(--navigation-a-color);
    font-size: 0.85rem;
  }
  a:hover,
  summary:hover {
    color: var(--a-color);
  }
  a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 0.35rem;
  }
  .brand {
    display: grid;
    font-size: 1rem;
    font-weight: 600;
    white-space: nowrap;
    gap: 0.2rem;
  }
  .brand span {
    font-size: 0.65rem;
    font-weight: 400;
    color: var(--hero-description-color);
  }
  summary {
    cursor: pointer;
    list-style: none;
    padding: 0.7rem;
    min-width: 44px;
    min-height: 44px;
    text-align: center;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.3rem;
  }
  .nav-group {
    display: flex;
    align-items: center;
    position: relative;
  }
  .nav-disclosure summary::after {
    content: '';
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    transform: rotate(45deg);
    vertical-align: 0.2rem;
  }
  .nav-disclosure[open] summary::after {
    transform: rotate(225deg);
  }
  .nav-disclosure summary {
    font-size: 1.2rem;
  }
  .submenu {
    position: absolute;
    top: 100%;
    left: 0;
    width: 13rem;
    background: var(--navigation-background-color);
    border: 1px solid var(--card-border-color);
    padding: 0.5rem;
    border-radius: 0.25rem;
    box-shadow: var(--box-shadow);
    display: grid;
  }
  .submenu a {
    padding: 0.75rem;
  }
  .nav-contact {
    border-bottom: 1px solid var(--a-color);
    padding-block: 0.5rem;
    gap: 0.75rem;
  }
  @media (min-width: 1024px) {
    .mobile-menu {
      display: none;
    }
  }
  @media (max-width: 1023px) {
    nav {
      flex-wrap: wrap;
    }
    .navigation-menu[open] {
      width: 100%;
    }
    .navigation-menu[open] > summary {
      position: absolute;
      right: 1rem;
      top: 1rem;
    }
    .nav-links {
      flex-direction: column;
      align-items: stretch;
      gap: 0.25rem;
      padding-block: 1rem;
      max-height: calc(100dvh - 7rem);
      overflow-y: auto;
    }
    .nav-links > a,
    .nav-group > a {
      padding: 0.75rem;
    }
    .nav-group {
      flex-wrap: wrap;
      justify-content: space-between;
    }
    .nav-group > a {
      flex: 1;
    }
    .nav-disclosure {
      display: contents;
    }
    .nav-disclosure .submenu {
      position: static;
      width: 100%;
      box-shadow: none;
      border: 0;
      border-left: 1px solid var(--card-border-color);
      margin-left: 0.75rem;
    }
  }
</style>
<script>
  class SiteNavigation extends HTMLElement {
    private controller?: AbortController;
    connectedCallback() {
      this.controller = new AbortController();
      const { signal } = this.controller;
      const desktop = matchMedia('(min-width: 1024px)');
      const menu = this.querySelector<HTMLDetailsElement>('.navigation-menu')!;
      const close = () => {
        this.querySelectorAll<HTMLDetailsElement>('.nav-disclosure').forEach(
          detail => (detail.open = false)
        );
        menu.open = desktop.matches;
      };
      close();
      desktop.addEventListener('change', close, { signal });
      this.addEventListener(
        'keydown',
        event => {
          if (event.key !== 'Escape') return;
          const target =
            [
              ...this.querySelectorAll<HTMLDetailsElement>(
                '.nav-disclosure[open]'
              ),
            ].reverse()[0] ||
            (!desktop.matches && menu.open ? menu : undefined);
          if (target) {
            target.open = false;
            target.querySelector('summary')?.focus();
            event.preventDefault();
          }
        },
        { signal }
      );
      this.addEventListener(
        'click',
        event => {
          if ((event.target as Element).closest('a')) close();
        },
        { signal }
      );
      this.addEventListener(
        'focusout',
        event => {
          if (
            event.relatedTarget &&
            !this.contains(event.relatedTarget as Node)
          )
            close();
        },
        { signal }
      );
      document.addEventListener(
        'click',
        event => {
          if (!this.contains(event.target as Node)) close();
        },
        { signal }
      );
    }
    disconnectedCallback() {
      this.controller?.abort();
    }
  }
  if (!customElements.get('site-navigation'))
    customElements.define('site-navigation', SiteNavigation);
</script>
