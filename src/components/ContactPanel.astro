---
interface Props {
  title?: string;
  description?: string;
  href?: string;
  label?: string;
}
const {
  title = 'Let’s find a useful starting point.',
  description = 'Tell me what you are building, who it is for, and what you want to improve. We’ll talk through the next step together.',
  href = '/contact',
  label = 'Tell me about your project',
} = Astro.props;
---

<section class="contact-panel">
  <div>
    <p class="eyebrow">Your next step</p><h2>{title}</h2><p>{description}</p>
  </div>
  <div class="editorial-actions">
    <a class="editorial-button" href={href}
      >{label} <span aria-hidden="true">→</span></a
    >
  </div>
</section>
