---
import { getCollection } from 'astro:content';
import Layout from '@layouts/default.astro';
const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const readingPaths = [
  ['Building with Astro', 'astro-experience'],
  ['Content-driven navigation', 'content-driven-navigation-enhancing-ux'],
  ['Automating workflows with GenAIScript', 'genaiscript-usage'],
];
---

<Layout
  title="Notes on design & development — Andrew Noblet"
  description="Notes on web development, component architecture, creative workflows, and digital minimalism. Articles by Andrew Noblet with AI-assisted content labeled."
>
  <div class="editorial-page">
    <section class="editorial-section editorial-lead">
      <div class="section-heading">
        <h1 class="editorial-title">Blog</h1>
        <p>
          Notes on web development, interface design, and development workflows.
          AI-assisted articles are labeled.
        </p>
      </div>
      <nav class="reading-paths" aria-label="Featured articles">
        <h2>Start here</h2>
        {
          readingPaths.map(([label, id]) => (
            <a href={'/blog/' + id}>
              {label} <span aria-hidden="true">↗</span>
            </a>
          ))
        }
      </nav>
    </section>
    <h2 class="archive-heading">All articles</h2>
    <ol class="post-list">
      {
        posts.map(post => (
          <li>
            <>
              <div>
                <time datetime={post.data.date.toISOString()}>
                  {post.data.date.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                    timeZone: 'UTC',
                  })}
                </time>
                {post.data.ai && <span>AI-assisted</span>}
              </div>
              <h3>
                <a href={'/blog/' + post.id}>{post.data.title}</a>
              </h3>
              <p>{post.data.description}</p>
            </>
          </li>
        ))
      }
    </ol>
  </div>
</Layout>
<style>
  .reading-paths {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
  }
  .reading-paths h2 {
    flex-basis: 100%;
    font-size: 1rem;
    letter-spacing: 0;
  }
  .reading-paths a {
    gap: 0.35rem;
    min-height: 44px;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .archive-heading {
    font-size: 1.5rem;
    line-height: 1.3;
  }
  .post-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    list-style: none;
    gap: 0 3rem;
    padding: 0;
    margin-bottom: 0;
  }
  li {
    border-top: 1px solid var(--card-border-color);
    padding: 2rem 0;
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }
  li::marker {
    content: '';
  }
  li > div {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    color: var(--hero-description-color);
    font-size: 0.75rem;
  }
  li h3 {
    font-size: 1.4rem;
    line-height: 1.4;
  }
  li h3 a:hover,
  li h3 a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  p {
    color: var(--hero-description-color);
    line-height: 1.8;
  }
  @media (max-width: 760px) {
    .post-list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
