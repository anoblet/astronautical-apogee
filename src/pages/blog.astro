---
import { getCollection } from 'astro:content';
import Layout from '@layouts/default.astro';
const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<Layout
  title="Notes on design & development — Andrew Noblet"
  description="Notes on web development, component architecture, creative workflows, and digital minimalism. Articles by Andrew Noblet with AI-assisted content labeled."
>
  <div class="editorial-page">
    <section class="editorial-section">
      <div class="section-heading">
        <p class="eyebrow">The notebook</p><h1 class="editorial-title">
          Ideas, experiments,<br />and things learned.
        </h1><p>
          Notes on building for the web, keeping things simple, and exploring
          new tools. AI-assisted articles are labeled so their provenance is
          clear.
        </p>
      </div>
    </section>
    <ol class="post-list">
      {
        posts.map(post => (
          <li>
            <>
              <div>
                <time datetime={post.data.date.toISOString()}>
                  {post.data.date.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                    timeZone: 'UTC',
                  })}
                </time>
                {post.data.ai && <span>AI-assisted</span>}
              </div>
              <h2>
                <a href={'/blog/' + post.id}>{post.data.title}</a>
              </h2>
              <p>{post.data.description}</p>
              <a
                href={'/blog/' + post.id}
                aria-label={`Read ${post.data.title}`}
              >
                Read article →
              </a>
            </>
          </li>
        ))
      }
    </ol>
  </div>
</Layout>
<style>
  .post-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    list-style: none;
    gap: 0 3rem;
    padding: 0;
  }
  li {
    border-top: 1px solid var(--card-border-color);
    padding: 2rem 0;
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }
  li::marker {
    content: '';
  }
  li > div {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    color: var(--hero-description-color);
    font-size: 0.75rem;
  }
  h2 {
    font-size: 1.4rem;
    line-height: 1.4;
  }
  p {
    color: var(--hero-description-color);
    line-height: 1.8;
  }
  @media (max-width: 760px) {
    .post-list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
