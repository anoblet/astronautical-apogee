---
import { getCollection } from 'astro:content';
import EditorialImage from '@components/EditorialImage.astro';
import Layout from '../layouts/default.astro';

const postCollection = await getCollection('blog');

const originalPosts = postCollection
  .filter(post => post.data.ai !== true)
  .sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
  );

const generatedPosts = postCollection
  .filter(post => post.data.ai === true)
  .sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
  );

// const posts = [...originalPosts, ...generatedPosts];
const posts = postCollection.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<Layout
  title="Blog"
  description="Discover new ideas, stories, and updates about web development, AI-driven features, creative workflows, and minimalist philosophy. Technical insights and practical guides from Andrew Noblet."
>
  <div class="gap grid max-width-56 width-100">
    <h1 class="text-align-center">Blog</h1>
    <p class="text-align-center">
      Discover new ideas, stories, and updates. Dive into topics that inspire,
      inform, and spark conversation—from web development to creative workflows.
    </p>
    <span></span>
    <ul class="gap-2 list">
      {
        posts.map(post => (
          <li class="gap grid">
            <div class="gap-0-5 grid">
              <span class="color-tertiary font-weight-700">
                {new Date(post.data.date).toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </span>
              <hr />
              <a class="font-weight-6" href={'/blog/' + post.id}>
                {post.data.title}
              </a>
            </div>
            <div>{post.data.description}</div>
            {post.data.image && (
              <a
                class="post-image"
                href={'/blog/' + post.id}
                aria-label={post.data.title}
              >
                <EditorialImage src={post.data.image} alt="" />
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</Layout>
<style>
  .post-image {
    display: block;
  }

  ul,
  li {
    padding: 0;
  }
</style>
