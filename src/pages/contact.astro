---
import Layout from '@layouts/default.astro';
---

<Layout
  title="Let’s talk — Andrew Noblet"
  description="Book a free 30-minute discovery call or email Andrew Noblet about your design, website, hosting, or consultation project."
>
  <div class="editorial-page">
    <section class="editorial-section editorial-split">
      <div class="section-heading">
        <p class="eyebrow">Start a conversation</p><h1 class="editorial-title">
          Tell me what<br />you have in mind.
        </h1><p>
          Bring an idea, an existing website, or a question. A free 30-minute
          discovery call gives us a chance to understand the project and decide
          on a useful next step.
        </p>
      </div>
      <div class="editorial-prose">
        <p id="selected-package" hidden></p><h2>
          Book an introductory call.
        </h2><p>
          Choose an available time through Google Calendar. The introductory
          call is free and has no obligation. Booking is an inquiry, not a
          purchase of a paid package.
        </p><div>
          <a
            class="editorial-button"
            href="https://calendar.app.google/JjnLtVR6mnM11FcS9"
            >Choose a time →</a
          >
        </div><p>
          Prefer to write first? Email <a href="mailto:andrewbnoblet@gmail.com"
            >andrewbnoblet@gmail.com</a
          >.
        </p><h2>Helpful things to bring</h2><ul>
          <li>Your current website or a brief description of the idea.</li><li>
            Who it is for and what you want people to do.
          </li><li>
            Any constraints, questions, or timing you already know about.
          </li>
        </ul><p>
          If we decide to work together, your proposal will confirm
          deliverables, schedule, revisions, costs, and support before paid work
          begins. Paid consultation sessions are separate from this free
          discovery call.
        </p><a href="/pricing">Explore packages before we talk →</a>
      </div>
    </section>
  </div>
</Layout>
<script>
  const packages = new Set([
    'Basic',
    'Pro',
    'Starter Design',
    'Pro Design',
    'Basic Hosting',
    'Pro Hosting',
    'Quick Consult',
    'Project Consult',
    'Community Post Starter',
    'Local Basic',
    'Local Pro',
  ]);
  const services: Record<string, string> = {
    hosting: 'Hosting & deployment',
    consultation: 'Technical consultation',
    mentorship: 'Mentorship',
    design: 'Design',
    social: 'Social media support',
  };
  function showContext() {
    const query = new URLSearchParams(location.search);
    const choice = query.get('package');
    const label =
      choice && packages.has(choice)
        ? choice
        : services[query.get('service') || ''];
    const element = document.querySelector<HTMLElement>('#selected-package');
    if (element) {
      element.hidden = !label;
      element.textContent = label
        ? `You’re interested in ${label}. Mention this when you book or email so we can discuss the right scope.`
        : '';
    }
  }
  showContext();
  document.addEventListener('astro:page-load', showContext);
</script>
