---
import Layout from '@layouts/default.astro';
---

<Layout
  title="Contact Andrew Noblet"
  description="Book a free 30-minute discovery call or email Andrew Noblet about your design, website, hosting, or consultation project."
>
  <div class="editorial-page">
    <div class="editorial-section editorial-lead editorial-split">
      <section class="section-heading">
        <h1 class="editorial-title">Contact Andrew</h1>
        <p>
          Tell me about your website, design project, or technical question.
          We’ll use a free 30-minute discovery call to talk through what you
          need and decide on a next step.
        </p>
      </section>
      <section class="editorial-prose booking">
        <h2>Book a discovery call</h2>
        <p id="selected-package" hidden></p>
        <div>
          <a
            class="editorial-button"
            href="https://calendar.app.google/JjnLtVR6mnM11FcS9"
            >Choose a time on Google Calendar <span aria-hidden="true">↗</span
            ></a
          >
        </div>
        <p>
          Prefer email? Write to <a
            id="inquiry-email"
            href="mailto:andrewbnoblet@gmail.com">andrewbnoblet@gmail.com</a
          >.
        </p>
      </section>
    </div>
    <section class="editorial-section editorial-split">
      <h2>What to bring</h2>
      <div class="editorial-prose">
        <ul>
          <li>Your current website or a brief description of your idea.</li>
          <li>Who it’s for and what you want them to be able to do.</li>
          <li>Any deadlines, constraints, or questions you have.</li>
        </ul>
        <p>
          If we decide to work together, I’ll send a proposal with deliverables,
          timing, costs, and support before paid work begins.
        </p>
        <a href="/pricing"
          >Compare packages before we talk <span aria-hidden="true">↗</span></a
        >
      </div>
    </section>
  </div>
</Layout>
<style>
  .section-heading {
    align-content: start;
  }
  .booking {
    padding: clamp(1rem, 4vw, 2rem);
    border: 1px solid var(--card-border-color);
    border-radius: 0.75rem;
    background: color-mix(
      in srgb,
      var(--a-color) 7%,
      var(--body-background-color)
    );
    overflow-wrap: anywhere;
  }
  .booking .editorial-button {
    text-align: center;
  }
  ul {
    list-style: disc;
    padding: 0 0 0 1.25rem;
  }
  li {
    padding: 0;
  }
  li::marker {
    content: normal;
  }
</style>

<script>
  const packages = new Set([
    'Basic',
    'Pro',
    'Starter Design',
    'Pro Design',
    'Basic Hosting',
    'Pro Hosting',
    'Quick Consult',
    'Project Consult',
    'Community Post Starter',
    'Local Basic',
    'Local Pro',
  ]);
  const services: Record<string, string> = {
    hosting: 'Hosting & deployment',
    consultation: 'Technical consultation',
    mentorship: 'Mentorship',
    design: 'Design',
    social: 'Social media support',
    tutoring: 'computer tutoring',
  };
  function showContext() {
    const query = new URLSearchParams(location.search);
    const choice = query.get('package');
    const label =
      choice && packages.has(choice)
        ? choice
        : Object.hasOwn(services, query.get('service') || '')
          ? services[query.get('service') || '']
          : undefined;
    const element = document.querySelector<HTMLElement>('#selected-package');
    const email = document.querySelector<HTMLAnchorElement>('#inquiry-email');
    if (email) {
      const address = 'mailto:andrewbnoblet@gmail.com';
      email.href = label
        ? address + '?subject=' + encodeURIComponent(`Inquiry about ${label}`)
        : address;
    }
    if (element) {
      element.hidden = !label;
      element.textContent = label
        ? `You’re interested in ${label}. Mention it when booking so we can discuss the right scope.`
        : '';
    }
  }
  showContext();
  document.addEventListener('astro:page-load', showContext);
</script>
