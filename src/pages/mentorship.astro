---
import Layout from '@layouts/default.astro';
import Card from '@components/Card.astro';
import EditorialImage from '@components/EditorialImage.astro';
import ContactPanel from '@components/ContactPanel.astro';
import image from '@assets/images/collaboration-team-fist-bump.webp';
---

<Layout
  title="Software development mentorship — Andrew Noblet"
  description="Practical guidance for developers working on technical skills, portfolios, and career decisions. Start with a free discovery call to discuss your goals."
>
  <div class="editorial-page">
    <section class="editorial-hero">
      <div class="hero-copy">
        <p class="eyebrow">Mentorship</p><h1>
          Build your skills.<br />Find your direction.
        </h1><p>
          Work through software development with someone alongside you. We start
          with your experience, the questions you have, and what you want to be
          able to do next.
        </p><div class="editorial-actions">
          <a class="editorial-button" href="/contact?service=mentorship"
            >Discuss your learning goals →</a
          ><a href="#mentorship-process">How sessions work ↓</a>
        </div>
      </div><figure><EditorialImage src={image} priority /></figure>
    </section>
    <section class="editorial-section">
      <div class="section-heading">
        <p class="eyebrow">01 / Your learning goals</p><h2>
          Make room for<br />practice and feedback.
        </h2><p>
          Mentorship suits developers building confidence in their work,
          exploring a technical direction, or preparing a portfolio. We choose a
          focus that matches your starting point.
        </p>
      </div><div class="editorial-grid">
        <Card
          ><h3>Technical skills</h3><p>
            Practice JavaScript, TypeScript, CSS, and Web Components through
            code you can discuss and improve. Explore testing, performance, and
            component structure in context.
          </p></Card
        ><Card
          ><h3>Project feedback</h3><p>
            Bring a personal project or a piece of code you are working on. We
            can examine the approach, work through a blocker, and identify the
            next exercise or improvement.
          </p></Card
        ><Card
          ><h3>Career direction</h3><p>
            Discuss your portfolio, resume, interview preparation, and the kinds
            of work you want to pursue. Use concrete examples to explain your
            experience.
          </p></Card
        ><Card
          ><h3>A focused technical decision</h3><p>
            If you need a review or recommendation for a project rather than
            ongoing learning, <a href="/services/consultation"
              >technical consultation</a
            > may be a better starting point.
          </p></Card
        >
      </div>
    </section>
    <section id="mentorship-process" class="editorial-section">
      <div class="section-heading">
        <p class="eyebrow">02 / How we work</p><h2>
          A conversation.<br />A practical exercise.<br />Something to build on.
        </h2>
      </div><ol class="process-list">
        <li>
          <h3>Start with your goals</h3><p>
            Use a free discovery call to discuss experience, questions, and a
            useful focus.
          </p>
        </li><li>
          <h3>Agree on a plan</h3><p>
            Confirm session format, frequency, fees, preparation, and feedback
            expectations before ongoing work.
          </p>
        </li><li>
          <h3>Work on real examples</h3><p>
            Bring code, a portfolio draft, or a technical question. Discuss the
            reasoning as well as the result.
          </p>
        </li><li>
          <h3>Review your progress</h3><p>
            Use what you learn between sessions and adjust the plan as your
            needs change.
          </p>
        </li>
      </ol>
    </section>
    <section class="editorial-section editorial-split">
      <div class="section-heading">
        <p class="eyebrow">03 / Before we begin</p><h2>
          Bring your curiosity.
        </h2>
      </div><div class="editorial-prose">
        <p>
          You do not need a polished portfolio to start. A small project, a
          rough draft, or a description of where you get stuck gives us
          something to discuss.
        </p><p>
          Mentorship provides guidance and feedback. It does not promise a job,
          a promotion, or a particular learning timeline. We define the scope
          and terms together after the introductory conversation.
        </p>
      </div>
    </section>
    <ContactPanel
      title="What would you like to learn next?"
      description="Tell me about your experience and the work you want to do. We’ll use a free discovery call to see whether mentorship is a useful fit."
      href="/contact?service=mentorship"
      label="Discuss mentorship"
    />
  </div>
</Layout>
