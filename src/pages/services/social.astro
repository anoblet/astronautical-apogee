---
import EditorialImage from '@components/EditorialImage.astro';
import pageImage from '@assets/images/community-hands-together.webp';
import CallToAction from '@components/CallToAction.astro';
import Layout from '@layouts/default.astro';
import Card from '@components/Card.astro';
---

<Layout
  title="Social Media Management | Andrew Noblet"
  description="Thoughtful Facebook community-group posts for local small businesses. Post writing, group-rule review, owner approval, and reply follow-up with one-time and monthly packages."
>
  <div class="grid gap-3 page">
    <section class="column flex gap-2 align-items-center">
      <h1>Social Media Management</h1>
      <p class="hero-description">
        Connect with the neighbors who could become your next customers. I help
        local small businesses write useful, personal Facebook community-group
        posts and follow up on the conversations they start.
      </p>
      <a href="/services/social/pricing">Explore packages and pricing</a>
    </section>

    <section class="gap grid">
      <h2>A Community Post, From Idea to Follow-up</h2>
      <div class="grid auto-fit-15 gap-2">
        <Card>
          <h3>Your Business, Your Voice</h3>
          <p>
            We start with your services, neighborhood, photos, and goals. Each
            post uses facts you confirm and sounds like you.
          </p>
        </Card>
        <Card>
          <h3>Respect for Each Group</h3>
          <p>
            I review group rules before drafting. Where promotion is prohibited,
            we skip the post or ask administrators for permission first.
          </p>
        </Card>
        <Card>
          <h3>Your Approval Comes First</h3>
          <p>
            You review the exact text before it goes live. You or an authorized
            manager posts through your real account, where the group permits it.
          </p>
        </Card>
        <Card>
          <h3>Follow Through</h3>
          <p>
            Each post includes 48 hours of reply monitoring and response drafts
            for your approval. We record available engagement and genuine leads.
          </p>
        </Card>
      </div>
    </section>
    <EditorialImage src={pageImage} />

    <section class="gap grid">
      <h2>Choose the Support You Need</h2>
      <div class="grid auto-fit-15 gap-2">
        <Card>
          <h3>Community Post Starter</h3>
          <p>
            Try one post with profile and page setup, a group-rule review, and
            48 hours of reply monitoring. A one-time package with no monthly
            commitment.
          </p>
        </Card>
        <Card>
          <h3>Local Basic</h3>
          <p>
            Stay present in one neighborhood with four posts each month across
            one or two groups, reply handling, and a monthly one-page summary.
          </p>
        </Card>
        <Card>
          <h3>Local Pro</h3>
          <p>
            Support a growing business with eight to twelve posts each month
            across two to four groups, comment and message triage, basic
            metrics, and a monthly photo or video prompt.
          </p>
        </Card>
      </div>
    </section>

    <section class="gap grid">
      <h2>Helpful, Honest, and Local</h2>
      <p>
        Posts can introduce your business, share a useful tip, or highlight an
        event when group rules allow. Every post uses your real identity and
        confirmed business details. Results depend on the group and the offer;
        reporting covers the engagement we can observe and inquiries received.
      </p>
    </section>

    <section class="gap grid text-align-center">
      <h2>Let's Talk About Your Neighborhood</h2>
      <p>
        Bring your business goals and the groups you belong to. We'll discuss
        what is allowed and which package fits.
      </p>
      <div class="flex justify-content-center">
        <CallToAction
          href="https://calendar.app.google/JjnLtVR6mnM11FcS9"
          newTab
        >
          Book a Free Consultation
        </CallToAction>
      </div>
    </section>
  </div>
</Layout>
