---
import Layout from '@layouts/default.astro';
import PricingCard from '@components/PricingCard.astro';
---

<Layout
  title="Consultation Pricing"
  description="Expert technical consultation pricing plans. Strategic advice and guidance to accelerate your project development. Choose consultation plans that fit your specific needs and timeline."
>
  <h1 class="text-align-center font-size-2 margin-bottom-2">
    Consultation Pricing
  </h1>
  <p
    class="hero-description text-align-center margin-bottom-4 max-width-48 margin-auto"
  >
    Expert guidance and strategic advice to accelerate your project. Choose the
    consultation plan that fits your needs.
  </p>

  <div class="grid auto-fit-20 gap-2 width-100 max-width-64 margin-auto">
    <PricingCard
      title="Quick Consult"
      description="For those needing fast answers or a second opinion on a specific challenge."
      features={[
        '30-minute session',
        'Email summary',
        'Actionable next steps',
        'Email follow-up',
      ]}
      price="$99"
      buttonText="Book Now"
      buttonHref="/contact"
    />
    <PricingCard
      title="Project Consult"
      description="For teams or individuals seeking in-depth project review and recommendations."
      features={[
        '1-hour session',
        'Detailed project review',
        'Written report',
        'Priority email support',
      ]}
      price="$299"
      buttonText="Book Now"
      buttonHref="/contact"
    />
  </div>
</Layout>
