---
import Layout from '@layouts/default.astro';
import PricingCard from '@components/PricingCard.astro';
---

<Layout
  title="Hosting Pricing"
  description="Reliable, secure, and scalable web hosting pricing plans. Professional hosting solutions for every project size with transparent pricing that fits your needs and budget."
>
  <h1 class="text-align-center font-size-2 margin-bottom-2">Hosting Pricing</h1>
  <p
    class="hero-description text-align-center margin-bottom-4 max-width-48 margin-auto"
  >
    Reliable, secure, and scalable hosting solutions for every project size.
    Choose the plan that fits your needs.
  </p>

  <div class="grid auto-fit-20 gap-2 width-100 max-width-64 margin-auto">
    <PricingCard
      title="Basic Hosting"
      description="For personal sites and small projects needing dependable uptime and support."
      features={[
        '99.9% uptime',
        'SSL certificate',
        'Daily backups',
        'Email support',
      ]}
      price="$49.99/mo"
      buttonText="Get Hosting"
      buttonHref="/contact"
    />
    <PricingCard
      title="Pro Hosting"
      description="For businesses and growing sites requiring more resources and priority support."
      features={[
        'Enhanced performance',
        'Staging environment',
        'Priority support',
        'Advanced security',
      ]}
      price="$99.99/mo"
      buttonText="Get Hosting"
      buttonHref="/contact"
    />
  </div>
</Layout>
