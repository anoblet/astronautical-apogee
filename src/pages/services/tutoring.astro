---
import Layout from '@layouts/default.astro';
import Card from '@components/Card.astro';
import EditorialImage from '@components/EditorialImage.astro';
import ContactPanel from '@components/ContactPanel.astro';
import image from '@assets/images/development-laptop-workspace.webp';

const topics = [
  [
    'Computer basics',
    'Practice typing, finding files, and using a computer with more confidence.',
  ],
  [
    'Scratch',
    'Snap blocks together to make a character move, tell a story, or build a simple game.',
  ],
  [
    'Python',
    'Write a short program and see how variables, decisions, and loops work together.',
  ],
];
---

<Layout
  title="Computer tutoring for all ages — Andrew Noblet"
  description="Hands-on computer tutoring for all ages in the Tarrytown and Westchester area. Explore computer basics, Scratch, and beginner Python."
>
  <div class="editorial-page">
    <section class="editorial-hero">
      <div class="hero-copy">
        <p class="eyebrow">Computer tutoring</p>
        <h1>Build computer skills at your own pace.</h1>
        <p>
          Learners of all ages are welcome. Build everyday computer skills or
          try a first coding project with hands-on lessons in Tarrytown and
          nearby Westchester communities.
        </p>
        <div class="editorial-actions">
          <a class="editorial-button" href="/contact?service=tutoring"
            >Ask about tutoring ↗</a
          >
          <a href="#tutoring-pricing">View tutoring pricing ↗</a>
        </div>
      </div>
      <figure><EditorialImage src={image} priority /></figure>
    </section>
    <section class="editorial-section">
      <div class="section-heading"><h2>What we can work on</h2></div>
      <div class="editorial-grid">
        {
          topics.map(([title, description]) => (
            <Card>
              <h3>{title}</h3>
              <p>{description}</p>
            </Card>
          ))
        }
      </div>
    </section>
    <section class="editorial-section editorial-split" id="tutoring-pricing">
      <div class="section-heading">
        <h2>Tutoring pricing</h2>
      </div>
      <div class="editorial-prose">
        <p>
          <strong>$100</strong> per one-hour session. We can confirm the meeting
          location and what to bring when you get in touch.
        </p>
        <a href="/contact?service=tutoring">Ask about a session ↗</a>
      </div>
    </section>
    <ContactPanel
      title="Find a starting point."
      description="Tell me what you’d like to learn or share the goals of the learner you’re contacting me for. We’ll choose a starting point based on what the learner already knows."
      href="/contact?service=tutoring"
      label="Ask about tutoring"
    />
  </div>
</Layout>
