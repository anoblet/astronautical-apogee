---
import Layout from '@layouts/default.astro';
import PricingCard from '@components/PricingCard.astro';
---

<Layout
  title="Design Pricing"
  description="Professional UI/UX design pricing plans. Creative and user-focused design solutions for brands and products. Choose flexible pricing options that fit your vision and budget."
>
  <h1 class="text-align-center font-size-2 margin-bottom-2">Design Pricing</h1>
  <p
    class="hero-description text-align-center margin-bottom-4 max-width-48 margin-auto"
  >
    Professional, creative, and user-focused design solutions for brands and
    products. Choose the plan that fits your vision.
  </p>

  <div class="grid auto-fit-20 gap-2 width-100 max-width-64 margin-auto">
    <PricingCard
      title="Starter Design"
      description="For individuals and startups needing a polished, modern look for their first project."
      features={[
        'Logo & brand colors',
        '1 landing page',
        'Basic style guide',
        'Email support',
      ]}
      price="$499"
      buttonText="Get Design"
      buttonHref="/contact"
    />
    <PricingCard
      title="Pro Design"
      description="For growing businesses seeking a cohesive brand and multi-page design system."
      features={[
        'Full brand kit',
        'Up to 5 pages',
        'Component library',
        'Priority support',
      ]}
      price="$999"
      buttonText="Get Design"
      buttonHref="/contact"
    />
  </div>
</Layout>
