---
import EditorialImage from '@components/EditorialImage.astro';
import pageImage from '@assets/images/design-digital-workspace.webp';
import Layout from '../../layouts/default.astro';
import Card from '@components/Card.astro';
import ArrowForward from '@icons/arrow-forward.svg';
---

<Layout
  title="Brand & UI/UX Design Services"
  description="Brand identity, website, and UI/UX design for small businesses and digital products. Explore a collaborative process, practical deliverables, and design packages."
>
  <div class="design-page">
    <section class="design-hero">
      <div class="hero-copy">
        <p class="eyebrow">Design with purpose</p>
        <h1>A clear identity.<br />A better experience.</h1>
        <p class="hero-description">
          Help people understand your business and take the next step. I create
          brand identities, websites, and product interfaces with clear
          messages, thoughtful visuals, and straightforward paths through the
          experience.
        </p>
        <div class="hero-actions">
          <a class="design-button" href="/contact"
            >Let’s talk about your project <ArrowForward /></a
          >
          <a class="text-link" href="#design-services"
            >Explore services <span aria-hidden="true">↓</span></a
          >
        </div>
        <p class="hero-note">Brand identity · Websites · Digital products</p>
      </div>
      <figure class="hero-image">
        <EditorialImage
          src={pageImage}
          priority
          sizes="(max-width: 760px) calc(100vw - 2rem), 520px"
        />
        <figcaption>
          <span>From the first sketch</span><span>to the finer details.</span>
        </figcaption>
      </figure>
    </section>

    <section class="intro-strip">
      <p class="eyebrow">Brand & UI/UX design</p>
      <p>
        Whether you are launching your first service, refreshing a website, or
        simplifying a digital product, we start with what people need to do.
        Together, we turn your goals into a design that feels like your business
        and gives visitors the information they need.
      </p>
    </section>

    <section class="design-section services-section" id="design-services">
      <div class="section-heading">
        <p class="eyebrow">01 / What I do</p>
        <h2>Good design brings<br />everything together.</h2>
        <p>
          A project can focus on one area or combine several. We choose the work
          that supports your immediate goal and define the pages, assets, and
          review stages in your proposal before design begins.
        </p>
      </div>
      <div class="service-grid">
        <Card>
          <span class="service-number" aria-hidden="true">01</span><h3>
            Brand Identity & Landing Pages
          </h3>
          <p>
            Build a recognizable starting point for your business. Bring your
            logo, colors, and page design together so visitors understand who
            you are, what you offer, and how to get in touch.
          </p>
          <ul>
            <li>Logo and brand color direction</li>
            <li>Typography and basic style guidance</li>
            <li>Landing page design</li>
            <li>Brand kits for broader projects</li>
          </ul>
        </Card>
        <Card>
          <span class="service-number" aria-hidden="true">02</span><h3>
            User Experience Design
          </h3>
          <p>
            Make information easier to find and tasks easier to complete. We
            examine the experience from your audience’s perspective, then
            organize content and interactions around their needs.
          </p>
          <ul>
            <li>Audience discovery and research planning</li>
            <li>Information architecture and navigation</li>
            <li>User journeys and task flows</li>
            <li>Usability reviews and testing by agreement</li>
          </ul>
        </Card>
        <Card>
          <span class="service-number" aria-hidden="true">03</span><h3>
            User Interface Design
          </h3>
          <p>
            Give your website or app a clear visual hierarchy and a consistent
            feel. I design screens that make content readable, actions easy to
            identify, and important information accessible across screen sizes.
          </p>
          <ul>
            <li>Detailed page and screen mockups</li>
            <li>Responsive layouts</li>
            <li>Forms, navigation, and interaction states</li>
            <li>Contrast, readability, and keyboard focus guidance</li>
          </ul>
        </Card>
        <Card>
          <span class="service-number" aria-hidden="true">04</span><h3>
            Design Systems
          </h3>
          <p>
            Keep new pages and features consistent as your product grows. A
            shared set of styles and reusable components gives your team a
            practical reference for future work.
          </p>
          <ul>
            <li>Reusable component libraries</li>
            <li>Color, typography, and spacing tokens</li>
            <li>Component states and usage guidance</li>
            <li>Documentation for design and development</li>
          </ul>
        </Card>
      </div>
    </section>

    <section class="design-section process-section">
      <div class="section-heading">
        <p class="eyebrow">02 / How we work</p>
        <h2>A thoughtful process.<br />Room for your feedback.</h2>
        <p>
          You review the work at key stages so feedback can shape the direction
          before we move into finer details. The depth of each stage depends on
          the project and the scope we agree on.
        </p>
      </div>
      <div class="process-grid">
        <Card>
          <span class="process-number" aria-hidden="true">01</span><h3>
            Research & Discovery
          </h3>
          <p>
            We talk through your audience, goals, existing materials, and the
            problems you want to solve. Customer feedback, examples you like,
            and a review of your current site help us identify priorities.
          </p>
        </Card>
        <Card>
          <span class="process-number" aria-hidden="true">02</span><h3>
            Structure & Wireframes
          </h3>
          <p>
            I map the content, page structure, and key actions before adding
            visual polish. Wireframes help us decide what belongs on each page
            and how someone moves from a first visit to an inquiry or purchase.
          </p>
        </Card>
        <Card>
          <span class="process-number" aria-hidden="true">03</span><h3>
            Visual Design
          </h3>
          <p>
            We develop the visual direction through typography, color, imagery,
            and layout. Detailed mockups show how the agreed pages and
            components work together, including layouts for smaller screens.
          </p>
        </Card>
        <Card>
          <span class="process-number" aria-hidden="true">04</span><h3>
            Prototype & Refine
          </h3>
          <p>
            Where useful, interactive prototypes let us walk through important
            tasks before development. We review the flow, refine confusing
            steps, and prepare the agreed files and notes for handoff.
          </p>
        </Card>
      </div>
    </section>

    <section class="design-section editorial-section">
      <div>
        <p class="eyebrow">03 / Built around your audience</p>
        <h2>Every detail starts<br />with a real need.</h2>
      </div>
      <div class="prose">
        <p>
          A useful design answers the questions people bring to your website.
          For a local service business, that might mean making service areas,
          examples of work, and contact details easy to find. For a product, it
          could mean simplifying signup or making the next step in a task easier
          to understand.
        </p>
        <p>
          We identify those moments early and use them to guide decisions about
          content, navigation, and layout. That gives feedback a clear focus:
          can someone understand the offer, find what they need, and act with
          confidence?
        </p>
      </div>
    </section>

    <section class="design-section deliverables-section">
      <div>
        <p class="eyebrow">04 / The handoff</p>
        <h2>Ready for<br />what comes next.</h2>
      </div>
      <div class="prose">
        <p>
          Your proposal lists the deliverables and handoff requirements for your
          project. Depending on the scope, the final work can include:
        </p>
        <ul>
          <li>Approved brand assets and a guide to colors and typography.</li>
          <li>Page layouts and responsive mockups for agreed screen sizes.</li>
          <li>Reusable components with relevant interaction states.</li>
          <li>Prototypes showing key paths through the experience.</li>
          <li>Organized design files and notes to support implementation.</li>
        </ul>
        <p>
          We also discuss practical details such as long headings, empty
          screens, form errors, and keyboard focus where they apply. Planning
          for these states helps the finished experience stay clear beyond the
          ideal example shown in a mockup. We confirm development
          responsibilities and any implementation support separately when
          defining the project.
        </p>
      </div>
    </section>

    <section class="design-section getting-started">
      <p class="eyebrow">05 / Getting started</p>
      <h2>Bring an idea.<br />We’ll find the starting point.</h2>
      <p>
        Bring your current website, existing brand materials, and a short
        description of what you want to improve. Customer questions or examples
        of places where people get stuck are especially useful. If you are
        starting fresh, a description of your audience and your main service
        gives us enough to begin the conversation.
      </p>
      <p>
        Starter Design pairs a logo and brand colors with one landing page and a
        basic style guide. Pro Design expands the scope to a full brand kit, up
        to five pages, and a component library. For research, prototypes, or a
        larger design system, we can discuss a scope tailored to the project.
      </p>
    </section>

    <section class="contact-panel">
      <div>
        <p class="eyebrow">Your next chapter</p>
        <h2>Let’s make something<br />that feels like you.</h2>
        <p>
          Tell me what you are building, who it is for, and where you want to
          go. We’ll work out the next step together.
        </p>
      </div>
      <div class="contact-actions">
        <a class="design-button" href="/contact"
          >Tell me about your project <ArrowForward /></a
        >
        <a class="text-link" href="/services/design/pricing"
          >Explore packages & pricing <ArrowForward /></a
        >
      </div>
    </section>
  </div>
</Layout>

<style>
  .design-page {
    --design-line: color-mix(in srgb, var(--text-color) 18%, transparent);
    --design-muted: var(--hero-description-color);
    width: 100%;
    max-width: 1160px;
    padding-top: 2rem;
  }
  .design-page p,
  .design-page li {
    line-height: 1.75;
  }
  .design-page h2 {
    font-size: clamp(1.75rem, 3vw, 2.6rem);
    line-height: 1.25;
    letter-spacing: -0.04em;
    color: var(--text-color);
  }
  .design-page h3 {
    color: var(--text-color);
    font-size: 1.2rem;
    line-height: 1.4;
  }
  .design-page .eyebrow {
    color: var(--a-color);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
  }
  .design-hero {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 3.5rem;
    align-items: center;
  }
  .hero-copy h1 {
    font-size: clamp(2.5rem, 4.5vw, 4rem);
    line-height: 1.12;
    letter-spacing: -0.055em;
    color: var(--text-color);
    margin-bottom: 1.75rem;
  }
  .hero-copy .hero-description {
    font-size: 1.05rem;
    line-height: 1.8;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-items: center;
    margin-top: 2rem;
  }
  .design-button {
    background: var(--button-background-color);
    color: var(--button-color);
    padding: 1rem 1.25rem;
    display: inline-flex;
    justify-content: center;
    gap: 1rem;
    border-radius: 0.3rem;
    font-size: 0.85rem;
    font-weight: 600;
    min-height: 48px;
  }
  .design-button:hover {
    background: var(--button-hover-background-color);
    color: var(--button-hover-color);
  }
  .design-page a:focus-visible {
    outline: 2px solid var(--a-color);
    outline-offset: 5px;
  }
  .design-page svg {
    width: 1.15rem;
    height: 1.15rem;
    flex-shrink: 0;
  }
  .text-link {
    display: inline-flex;
    gap: 0.75rem;
    font-size: 0.85rem;
    padding-block: 0.5rem;
  }
  .hero-note {
    color: var(--design-muted);
    font-size: 0.75rem;
    margin-top: 1.5rem;
  }
  .hero-image {
    margin: 0;
    padding: 0.75rem;
    background: var(--surface-background-color);
    border: 1px solid var(--design-line);
    border-radius: 0.5rem;
    transform: rotate(2deg);
  }
  .hero-image :global(img) {
    aspect-ratio: 1.05;
    object-fit: cover;
    border-radius: 0.2rem;
  }
  figcaption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0.25rem 0.25rem;
    color: var(--design-muted);
    font-size: 0.7rem;
  }
  .intro-strip {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 3rem;
    margin-top: 4rem;
    padding: 2rem 0;
    border-block: 1px solid var(--design-line);
  }
  .intro-strip .eyebrow {
    margin: 0.4rem 0 0;
  }
  .intro-strip > p:last-child {
    color: var(--design-muted);
    max-width: 65ch;
  }
  .design-section {
    padding-block: 4.5rem;
    scroll-margin-top: 6rem;
  }
  .section-heading {
    max-width: 660px;
    margin-bottom: 2.5rem;
  }
  .section-heading > p:last-child {
    margin-top: 1.25rem;
    color: var(--design-muted);
  }
  .service-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .service-grid :global(.card) {
    padding: 2rem;
    gap: 1.25rem;
    border: 1px solid var(--design-line);
    box-shadow: none;
    background: var(--surface-background-color);
    position: relative;
  }
  .service-number {
    color: var(--a-color);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
  }
  .service-grid :global(.card p) {
    color: var(--design-muted);
    max-width: 48ch;
  }
  .service-grid ul {
    border-top: 1px solid var(--design-line);
    padding-top: 1.25rem;
    font-size: 0.85rem;
  }
  .process-section {
    border-block: 1px solid var(--design-line);
  }
  .process-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.75rem;
  }
  .process-grid :global(.card) {
    padding: 0;
    border: 0;
    box-shadow: none;
    background: none;
    gap: 1rem;
  }
  .process-number {
    color: var(--a-color);
    font-size: 2.75rem;
    font-weight: 300;
    letter-spacing: -0.06em;
    border-bottom: 1px solid var(--design-line);
    padding-bottom: 1rem;
  }
  .process-grid :global(.card p) {
    font-size: 0.9rem;
    color: var(--design-muted);
  }
  .editorial-section,
  .deliverables-section {
    display: grid;
    grid-template-columns: 1fr 1.35fr;
    gap: 4rem;
  }
  .prose {
    display: grid;
    gap: 1.5rem;
    color: var(--design-muted);
  }
  .deliverables-section {
    border-block: 1px solid var(--design-line);
  }
  .deliverables-section ul {
    padding-block: 0;
  }
  .getting-started {
    max-width: 760px;
  }
  .getting-started > p:not(.eyebrow) {
    margin-top: 1.5rem;
    color: var(--design-muted);
  }
  .contact-panel {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 3rem;
    align-items: center;
    background: color-mix(
      in srgb,
      var(--a-color) 7%,
      var(--body-background-color)
    );
    border: 1px solid var(--design-line);
    border-radius: 0.5rem;
    padding: 3rem;
  }
  .contact-panel h2 {
    margin-bottom: 1.25rem;
  }
  .contact-panel p:not(.eyebrow) {
    max-width: 48ch;
    color: var(--design-muted);
  }
  .contact-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
  }
  @media (max-width: 1000px) {
    .design-hero {
      gap: 2rem;
    }
    .hero-actions {
      gap: 1rem;
    }
    .process-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem;
    }
    .contact-panel {
      padding: 2rem;
      gap: 2rem;
    }
  }
  @media (max-width: 760px) {
    .design-page {
      padding-top: 0;
    }
    .design-hero,
    .intro-strip,
    .editorial-section,
    .deliverables-section,
    .contact-panel {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }
    .hero-image {
      transform: none;
    }
    .hero-image :global(img) {
      aspect-ratio: 16 / 10;
    }
    .intro-strip {
      margin-top: 2.5rem;
      gap: 0.75rem;
    }
    .design-section {
      padding-block: 3rem;
    }
    .service-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .service-grid :global(.card) {
      padding: 1.5rem;
    }
    .contact-panel {
      padding: 1.5rem;
    }
    .contact-actions {
      align-items: stretch;
    }
    .contact-actions .text-link {
      justify-content: center;
    }
  }
  @media (max-width: 440px) {
    .process-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .hero-actions {
      align-items: stretch;
      flex-direction: column;
    }
  }
</style>
