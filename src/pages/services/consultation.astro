---
import Layout from '@layouts/default.astro';
import Card from '@components/Card.astro';
import EditorialImage from '@components/EditorialImage.astro';
import ContactPanel from '@components/ContactPanel.astro';
import image from '@assets/images/workspace-notebook-planning.webp';
---

<Layout
  title="Technical consultation — Andrew Noblet"
  description="A practical second perspective on architecture, code, performance, and project planning. Explore paid sessions and start with a free discovery call."
>
  <div class="editorial-page">
    <section class="editorial-hero">
      <div class="hero-copy">
        <p class="eyebrow">Technical consultation</p><h1>
          Work through the question.<br />Find the next step.
        </h1><p>
          When a project gets complicated, an outside perspective can help. We
          review the problem, weigh the options, and identify practical actions
          your team can take.
        </p><div class="editorial-actions">
          <a class="editorial-button" href="/contact?service=consultation"
            >Book a free discovery call →</a
          ><a href="/services/consultation/pricing">Explore paid sessions →</a>
        </div>
      </div><figure><EditorialImage src={image} priority /></figure>
    </section>
    <section class="editorial-section">
      <div class="section-heading">
        <p class="eyebrow">01 / What we can examine</p><h2>
          Decisions grounded<br />in your project.
        </h2><p>
          Choose a focused question or arrange a broader project review. We
          agree on the material to review and the expected output before the
          session.
        </p>
      </div><div class="editorial-grid">
        <Card
          ><h3>Architecture & technology</h3><p>
            Compare approaches in the context of your team, existing systems,
            and operating constraints. Discuss integrations, maintainability,
            and future changes.
          </p></Card
        ><Card
          ><h3>Code & performance</h3><p>
            Review a specific area of code or a measured performance problem.
            Identify places to simplify, investigate, or improve reliability.
          </p></Card
        ><Card
          ><h3>Planning & delivery</h3><p>
            Break requirements into practical stages. Review dependencies,
            implementation risks, and the information needed for a useful
            estimate.
          </p></Card
        ><Card
          ><h3>Team development</h3><p>
            Talk through code review, component architecture, and development
            practices. For ongoing individual learning, explore <a
              href="/mentorship">mentorship</a
            >.
          </p></Card
        >
      </div>
    </section>
    <section class="editorial-section">
      <div class="section-heading">
        <p class="eyebrow">02 / A focused conversation</p><h2>
          Prepare, discuss, move forward.
        </h2>
      </div><ol class="process-list">
        <li>
          <h3>Define the question</h3><p>
            Share the decision or problem and what a useful result would look
            like.
          </p>
        </li><li>
          <h3>Prepare the context</h3><p>
            Agree on relevant code, diagrams, measurements, or requirements to
            review.
          </p>
        </li><li>
          <h3>Compare options</h3><p>
            Discuss the evidence, tradeoffs, and work needed to test an
            approach.
          </p>
        </li><li>
          <h3>Plan next steps</h3><p>
            Use the summary or report included in your chosen package to guide
            follow-up work.
          </p>
        </li>
      </ol>
    </section>
    <section class="editorial-section editorial-split">
      <div class="section-heading">
        <p class="eyebrow">03 / Choose the right session</p><h2>
          A discovery call<br />is the starting point.
        </h2>
      </div><div class="editorial-prose">
        <p>
          The free introductory call helps us understand your needs and decide
          on the scope. Paid technical consultation starts at $99 for a
          30-minute session with an email summary and next steps. A $299 project
          consultation includes a one-hour session and written report.
        </p><p>
          Implementation, ongoing support, and additional reviews are scoped
          separately. Bring a short problem description and relevant examples;
          share project access only after we agree on what is needed.
        </p><a href="/services/consultation/pricing"
          >Compare consultation packages →</a
        >
      </div>
    </section>
    <ContactPanel
      title="Bring the question you are working on."
      description="Tell me about the project and the decision you need to make. We’ll use a free discovery call to define a useful next step."
      href="/contact?service=consultation"
    />
  </div>
</Layout>
