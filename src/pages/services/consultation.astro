---
import EditorialImage from '@components/EditorialImage.astro';
import pageImage from '@assets/images/workspace-notebook-planning.webp';
import Layout from '../../layouts/default.astro';
import Card from '@components/Card.astro';
---

<Layout
  title="Technical Consultation Services"
  description="Expert technical consultation to solve complex challenges and optimize development processes. Strategic advice on architecture, performance, and technical solutions that drive results."
>
  <div class="grid gap-3 page">
    <section class="column flex gap-2 align-items-center">
      <h1>Technical Consultation</h1>
      <p class="hero-description">
        Get expert guidance to solve complex technical challenges and optimize
        your development process. From architecture to performance, I deliver
        strategic advice that drives results.
      </p>
    </section>
    <section class="gap grid">
      <h2>My Approach</h2>
      <div class="grid auto-fit-15 gap-2">
        <div class="step-card">
          <h3>Assessment</h3>
          <p>Analyze your current situation, challenges, and goals.</p>
        </div>
        <div class="step-card">
          <h3>Strategy</h3>
          <p>
            Tailored recommendations based on best practices and your needs.
          </p>
        </div>
        <div class="step-card">
          <h3>Implementation</h3>
          <p>Guidance and support during implementation.</p>
        </div>
        <div class="step-card">
          <h3>Follow-up</h3>
          <p>
            Ongoing support for successful outcomes and continuous improvement.
          </p>
        </div>
      </div>
    </section>
    <EditorialImage src={pageImage} />
    <section class="gap grid">
      <h2>Consultation Services</h2>
      <div class="column gap grid">
        <Card>
          <h3>Technology Strategy</h3>
          <p>
            Strategic guidance on technology choices, architecture, and
            long-term roadmaps for sustainable growth.
          </p>
          <ul>
            <li>Technology stack evaluation</li>
            <li>Architecture planning</li>
            <li>Scalability assessment</li>
            <li>Future-proofing strategies</li>
          </ul>
        </Card>
        <Card>
          <h3>Code Review & Audits</h3>
          <p>
            Comprehensive code reviews and technical audits to identify
            improvements, security vulnerabilities, and performance bottlenecks.
          </p>
          <ul>
            <li>Code quality assessment</li>
            <li>Security vulnerability analysis</li>
            <li>Performance bottleneck identification</li>
            <li>Best practices recommendations</li>
          </ul>
        </Card>
        <Card>
          <h3>Project Planning & Estimation</h3>
          <p>
            Expert project planning and timeline estimation to break down
            complex requirements into manageable phases with realistic
            deliverables.
          </p>
          <ul>
            <li>Requirements analysis</li>
            <li>Timeline estimation</li>
            <li>Risk assessment</li>
            <li>Milestone planning</li>
          </ul>
        </Card>
        <Card>
          <h3>Performance Optimization</h3>
          <p>
            Deep-dive analysis of application performance with actionable
            recommendations for optimization across all layers of your
            application.
          </p>
          <ul>
            <li>Performance profiling</li>
            <li>Database optimization</li>
            <li>Frontend optimization</li>
            <li>Infrastructure tuning</li>
          </ul>
        </Card>
        <Card>
          <h3>Team Mentoring</h3>
          <p>
            Technical mentoring for development teams, including best practices,
            code standards, and professional development guidance.
          </p>
          <ul>
            <li>Development best practices</li>
            <li>Code review processes</li>
            <li>Team skill development</li>
            <li>Technical leadership</li>
          </ul>
        </Card>
        <Card>
          <h3>Problem Solving</h3>
          <p>
            Expert troubleshooting for complex technical challenges, system
            issues, and architectural problems that require deep technical
            expertise.
          </p>
          <ul>
            <li>Technical troubleshooting</li>
            <li>System debugging</li>
            <li>Architecture problem solving</li>
            <li>Emergency support</li>
          </ul>
        </Card>
      </div>
    </section>
    <consultation-component></consultation-component>
  </div>
</Layout>

<script>
  import '@components/consultation';
</script>
