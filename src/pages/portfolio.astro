---
import Layout from '@layouts/default.astro';
import ProjectGrid from '@components/ProjectGrid.astro';
import ContactPanel from '@components/ContactPanel.astro';
import { work } from '../data/work';
---

<Layout
  title="Portfolio — Andrew Noblet"
  description="Explore Andrew Noblet’s contributions to learning platforms, e-commerce, and business websites, alongside personal projects and working demos."
>
  <div class="editorial-page">
    <section class="editorial-section editorial-lead">
      <div class="section-heading">
        <h1 class="editorial-title">Portfolio</h1>
        <p>
          My work on business websites, online learning, and e-commerce, along
          with personal projects and web demos.
        </p>
      </div>
    </section>
    <section class="editorial-section">
      <h2>Professional work</h2>
      <ProjectGrid projects={work} />
    </section>
    <section class="editorial-section editorial-split">
      <h2>Personal projects</h2>
      <div class="editorial-prose">
        <p>
          Explore how this site is built, try the Angular and Lit demos, and see
          my component and workflow experiments.
        </p>
        <a href="/portfolio/personal"
          >Explore personal projects <span aria-hidden="true">↗</span></a
        >
      </div>
    </section>
    <ContactPanel />
  </div>
</Layout>
