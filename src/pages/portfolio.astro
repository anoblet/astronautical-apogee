---
import Layout from '@layouts/default.astro';
import Card from '@components/Card.astro';
import ContactPanel from '@components/ContactPanel.astro';
---

<Layout
  title="Selected work — Andrew Noblet"
  description="Explore Andrew Noblet’s contributions to learning platforms, e-commerce, and business websites, alongside personal projects and working demos."
>
  <div class="editorial-page">
    <section class="editorial-section">
      <div class="section-heading">
        <p class="eyebrow">The portfolio</p><h1 class="editorial-title">
          From an idea<br />to something useful.
        </h1><p>
          Explore professional contributions and personal experiments, with
          context about the work and links to the implementation where
          available.
        </p>
      </div>
    </section>
    <section class="editorial-section">
      <div class="editorial-grid">
        <Card
          ><p class="eyebrow">01 / Professional work</p><h2>
            Learning, shopping,<br />and discovery.
          </h2><p>
            Selected contributions to CXL, Graduation Source, and Avanti Systems
            USA. Read about my role, the features involved, and the technologies
            used.
          </p><a href="/portfolio/professional">Explore professional work →</a
          ></Card
        ><Card
          ><p class="eyebrow">02 / Personal projects</p><h2>
            Room to<br />try things.
          </h2><p>
            Look inside this website’s source, try the Angular island, and
            explore component and workflow experiments.
          </p><a href="/portfolio/personal">Explore personal projects →</a
          ></Card
        >
      </div>
    </section>
    <ContactPanel />
  </div>
</Layout>
