---
import Layout from '@layouts/default.astro';
import Card from '@components/Card.astro';
import EditorialImage from '@components/EditorialImage.astro';
import ContactPanel from '@components/ContactPanel.astro';
import image from '@assets/images/workspace-desk-plant.webp';
const services = [
  [
    'Brand & interface design',
    'Give your business a recognizable identity and your visitors a clear path. Brand direction, responsive page layouts, and product interfaces.',
    '/services/design',
    'Design services',
  ],
  [
    'Web development & hosting',
    'Build and maintain a practical web presence. Deployment, domains, performance, and ongoing care shaped around your project.',
    '/services/hosting',
    'Hosting & deployment',
  ],
  [
    'Technical consultation',
    'Work through architecture decisions, code quality, performance, and project planning with a second technical perspective.',
    '/services/consultation',
    'Technical consultation',
  ],
  [
    'Social media support',
    'Reach your neighbors through Facebook community groups. Post writing, owner approval, and reply follow-up with clear responsibilities.',
    '/services/social',
    'Social media support',
  ],
];
---

<Layout
  title="Services — Andrew Noblet"
  description="Explore design, website development, hosting, technical consultation, and local social media support. Define a practical scope with Andrew Noblet."
>
  <div class="editorial-page">
    <section class="editorial-hero">
      <div class="hero-copy">
        <p class="eyebrow">Services</p><h1>
          A clearer presence.<br />A practical next step.
        </h1><p>
          Whether you are starting fresh or improving something already in use,
          we begin with your audience, your goals, and the work that will make a
          difference.
        </p><div class="editorial-actions">
          <a class="editorial-button" href="/contact">Discuss your project →</a
          ><a href="/pricing">Explore packages →</a>
        </div>
      </div><figure><EditorialImage src={image} priority /></figure>
    </section>
    <section class="editorial-section">
      <div class="section-heading">
        <p class="eyebrow">01 / Choose your starting point</p><h2>
          Support for each stage<br />of your project.
        </h2><p>
          Start with one service or combine several. Your proposal confirms the
          deliverables, review stages, and responsibilities before paid work
          begins.
        </p>
      </div><div class="editorial-grid">
        {
          services.map(([title, description, href, label], index) => (
            <Card>
              <>
                <p class="eyebrow">0{index + 1}</p>
                <h3>{title}</h3>
                <p>{description}</p>
                <a href={href}>{label} →</a>
              </>
            </Card>
          ))
        }
      </div>
    </section>
    <section class="editorial-section editorial-split">
      <div class="section-heading">
        <p class="eyebrow">02 / Working together</p><h2>
          Define the work.<br />Keep the conversation open.
        </h2>
      </div><div class="editorial-prose">
        <p>
          Bring your current website, a rough idea, or a question you have been
          trying to answer. We use an introductory call to understand the
          situation and decide whether there is a useful fit.
        </p><p>
          If we move ahead, the proposal sets the scope, schedule, feedback
          stages, and support expectations. You know what is being designed,
          built, or reviewed.
        </p><a href="/portfolio/professional">See professional work →</a>
      </div>
    </section>
    <ContactPanel />
  </div>
</Layout>
