---
import ArrowForward from '@icons/arrow-forward.svg';
import Card from '@components/Card.astro';
import { Image } from 'astro:assets';
import Layout from '../layouts/default.astro';

const arrowForward = '';
---

<Layout
  title="Services"
  description="End-to-end digital solutions from design to deployment. Quality web development, hosting, and consultation services focused on performance and seamless user experiences."
>
  <div class="column flex gap-3 page">
    <div class="gap grid">
      <h1 class="text-align-center">Services</h1>
      <p class="hero-description text-align-center">
        End-to-end digital solutions to bring your ideas to life. From design
        and deployment to local community outreach, I help your business build a
        useful digital presence.
      </p>
    </div>
    <div class="column gap-2 grid">
      <Card>
        <h3>UI/UX Design</h3>
        <div class="flex-1">
          <p>
            Intuitive, user-friendly interfaces designed for engagement and
            clarity—always focused on user needs.
          </p>
          <ul>
            <li>User experience research and analysis</li>
            <li>Wireframing and prototyping</li>
            <li>Component-based design systems</li>
            <li>Accessibility-focused design</li>
          </ul>
        </div>
        <span></span>
        <a class="gap-0-5 align-self-flex-end" href="/services/design">
          Learn more <ArrowForward />
        </a>
      </Card>
      <Card>
        <h3>Web Hosting & Deployment</h3>
        <div class="flex-1">
          <p>
            Scalable, reliable hosting for any project. I manage deployment,
            optimization, and security so you can focus on growth.
          </p>
          <ul>
            <li>Server setup and configuration</li>
            <li>Performance optimization</li>
            <li>Security and maintenance</li>
            <li>CI/CD pipeline setup</li>
          </ul>
        </div>
        <span></span>
        <a class="gap-0-5 align-self-flex-end" href="/services/hosting">
          Learn more <ArrowForward />
        </a>
      </Card>
      <Card>
        <h3>Technical Consultation</h3>
        <div class="flex-1">
          <p>
            Strategic guidance for software development challenges—expert advice
            on technology, planning, and optimization.
          </p>
          <ul class="flex-1">
            <li>Technology stack recommendations</li>
            <li>Architecture planning</li>
            <li>Code review and optimization</li>
            <li>Project planning and strategy</li>
          </ul>
        </div>
        <span></span>
        <a class="gap-0-5 align-self-flex-end" href="services/consultation">
          Learn more <ArrowForward />
        </a>
      </Card>
      <Card>
        <h3>Social Media Management</h3>
        <div class="flex-1">
          <p>
            Reach your neighbors with thoughtful Facebook community-group posts
            written in your voice, approved by you, and tailored to each group's
            rules.
          </p>
          <ul>
            <li>Community-group research and rule review</li>
            <li>Post writing and owner approval</li>
            <li>Reply follow-up and lead tracking</li>
            <li>One-time and monthly packages</li>
          </ul>
        </div>
        <a
          class="gap-0-5 align-self-flex-end"
          href="/services/community-social"
        >
          Learn more <ArrowForward />
        </a>
      </Card>
    </div>
    <section class="gap grid justify-content-center text-align-center">
      <h2>Ready to Get Started?</h2>
      <p>Let's connect and find the perfect solution for your project.</p>
      <span class="space"></span>
      <div class="flex justify-content-center">
        <button-component
          href="https://calendar.app.google/JjnLtVR6mnM11FcS9"
          variant="primary"
          class="min-width-25vw"
        >
          Book a Free Consultation
          <ArrowForward />
        </button-component>
      </div>
    </section>
  </div>
</Layout>

<script>
  import '@components/button';
</script>
