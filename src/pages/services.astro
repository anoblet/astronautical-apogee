---
import Layout from '@layouts/default.astro';
import ServiceList from '@components/ServiceList.astro';
import ContactPanel from '@components/ContactPanel.astro';
---

<Layout
  title="Services — Andrew Noblet"
  description="Explore design, website development, hosting, technical consultation, local social media support, and computer tutoring for all ages. Define a practical scope with Andrew Noblet."
>
  <div class="editorial-page">
    <section class="editorial-section editorial-lead">
      <div class="section-heading">
        <h1 class="editorial-title">Design, websites, and ongoing support</h1>
        <p>
          Work directly with me on a new site, improvements to an existing one,
          or a technical decision. We’ll agree on the scope, schedule, and cost
          before work begins.
        </p>
      </div>
      <div class="editorial-actions">
        <a class="editorial-button" href="/pricing">Compare pricing</a>
        <a href="/contact"
          >Discuss your project <span aria-hidden="true">↗</span></a
        >
      </div>
    </section>
    <section class="editorial-section">
      <h2>Website services</h2>
      <ServiceList />
    </section>
    <section class="editorial-section">
      <h2>Local support & tutoring</h2>
      <ServiceList additional />
      <p>
        Developers looking for ongoing guidance can also <a href="/mentorship"
          >explore mentorship</a
        >.
      </p>
    </section>
    <ContactPanel />
  </div>
</Layout>
