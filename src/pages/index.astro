---
import Layout from '@layouts/default.astro';
import EditorialImage from '@components/EditorialImage.astro';
import ContactPanel from '@components/ContactPanel.astro';
import ProjectGrid from '@components/ProjectGrid.astro';
import ServiceList from '@components/ServiceList.astro';
import { work } from '../data/work';
import hero from '@assets/images/profile.webp';
const home = new URL('/', Astro.site).href;
const person = home + '#andrew-noblet';
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': person,
      name: 'Andrew Noblet',
      url: home,
      jobTitle: 'Software engineer',
    },
    {
      '@type': 'LocalBusiness',
      '@id': home + '#web-services',
      name: 'Andrew Noblet',
      url: new URL('/hosting/', Astro.site).href,
      founder: { '@id': person },
      areaServed: ['Westchester County, New York', 'New York City, New York'],
    },
  ],
};
const primaryAction = 'Book a free 30-minute discovery call';
---

<Layout
  title="Andrew Noblet — Design & development"
  description="Brand and interface design, web development, hosting, and practical technical guidance. Work directly with Andrew Noblet to build a clearer digital presence."
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(schema).replaceAll('<', '\\u003c')}
  />
  <div class="editorial-page">
    <section class="editorial-hero home-hero">
      <div class="hero-copy">
        <p class="eyebrow">Tarrytown, New York</p>
        <h1>Web design & development for small businesses.</h1>
        <p>
          I’m Andrew Noblet, a software engineer serving Westchester and New
          York City. Work directly with me from design through launch, or get
          remote technical guidance anywhere in the United States.
        </p>
        <div class="editorial-actions">
          <a class="editorial-button" href="/contact">{primaryAction}</a>
          <a href="/services"
            >Explore services <span aria-hidden="true">↗</span></a
          >
        </div>
      </div>
      <figure>
        <EditorialImage
          src={hero}
          alt="Andrew Noblet"
          priority
          sizes="(max-width: 760px) calc(100vw - 2rem), 540px"
        />
      </figure>
    </section>
    <section class="editorial-section">
      <div class="section-heading">
        <h2>Selected work</h2>
      </div>
      <ProjectGrid projects={work.slice(0, 2)} />
      <a class="section-link" href="/portfolio"
        >View the full portfolio <span aria-hidden="true">↗</span></a
      >
    </section>
    <section class="editorial-section">
      <div class="section-heading">
        <h2>How I can help</h2>
      </div>
      <ServiceList />
      <a class="section-link" href="/services"
        >View all services <span aria-hidden="true">↗</span></a
      >
    </section>
    <section class="editorial-section editorial-split">
      <div class="section-heading">
        <h2>About Andrew</h2>
      </div>
      <div class="editorial-prose">
        <p>
          I built my first website at 13 and petitioned my town for a skatepark
          at 14. These days I make things with web components, 3D printers, and
          home automation.
        </p>
        <a href="/about">More about me <span aria-hidden="true">↗</span></a>
      </div>
    </section>
    <ContactPanel label={primaryAction} />
  </div>
</Layout>

<style>
  .home-hero h1 {
    max-width: 20ch;
  }
  .home-hero :global(img) {
    aspect-ratio: 4 / 3;
    object-position: center 42%;
  }
  .section-link {
    justify-self: start;
    gap: 0.35rem;
    min-height: 44px;
  }
  @media (max-width: 760px) {
    .home-hero :global(img) {
      aspect-ratio: 16 / 10;
    }
  }
</style>
