---
import Layout from '../layouts/default.astro';
---

<Layout
  title="Andrew Noblet"
  description="Andrew Noblet - Software Engineer specializing in modern, accessible web experiences. Crafting inclusive digital solutions with expert design, hosting, and consultation services."
>
  <index-component></index-component>
</Layout>
<script>
  import { Base } from '@components/base';
  import '@components/button';
  import { globalStyles } from '@styles/global.ts';
  import { css, html } from 'lit';

  const taglines = [
    'Crafting Modern, Accessible Web Experiences',
    'Building Inclusive Digital Solutions',
    'Designing for Everyone, Everywhere',
    'Empowering Users with Accessible Design',
    'Innovating for a Better Web Experience',
    'Creating Seamless, Accessible Interfaces',
    'Fostering Accessibility in Web Development',
    'Championing Inclusive Web Design',
  ];

  class IndexComponent extends Base {
    private randomTagline =
      taglines[Math.floor(Math.random() * taglines.length)];

    static styles = [
      globalStyles,
      css`
        :host {
          flex: 1;
          width: 100%;
        }

        section {
          display: flex;
          flex: 1;
          justify-content: center;
          align-items: center;
          flex-direction: column;

          h1 {
            color: var(--index-h1-color);
            font-size: 1.75rem;
            font-weight: 500;
            margin: 0;
            padding: 2rem;
          }

          #buttons {
            min-width: 50%;

            > * {
              display: flex;

              button-component {
                flex: 1;
              }
            }

            a {
              &:hover {
                text-decoration: none;
              }
            }
          }
        }
      `,
    ];

    render() {
      return html`
        <section>
          <div class="desktop">
            <h1 class="text-align-center">
              Andrew Noblet |
              <span class="font-weight-800">${this.randomTagline}</span>
            </h1>
          </div>
          <div class="mobile">
            <h1 class="grid text-align-center">
              <span class="text-align-center">Andrew Noblet</span>
              <span class="font-weight-800">${this.randomTagline}</span>
            </h1>
          </div>
          <div class="desktop align-items-center">
            <div class="flex gap min-width-50 padding" id="buttons">
              <button-component href="/portfolio/personal" variant="primary">
                Personal Projects
              </button-component>
              <button-component
                href="/portfolio/professional"
                variant="secondary"
              >
                Professional Work
              </button-component>
            </div>
          </div>
          <div class="mobile">
            <div class="column gap grid min-width-50 padding" id="buttons">
              <button-component href="/portfolio/personal" variant="primary">
                Personal Projects
              </button-component>
              <button-component
                href="/portfolio/professional"
                variant="secondary"
              >
                Professional Work
              </button-component>
            </div>
          </div>
        </section>
      `;
    }
  }

  customElements.define('index-component', IndexComponent);
</script>
