---
import Layout from '@layouts/default.astro';
import EditorialImage from '@components/EditorialImage.astro';
import ContactPanel from '@components/ContactPanel.astro';
import Card from '@components/Card.astro';
import hero from '@assets/images/workspace-minimal-keyboard.webp';
---

<Layout
  title="Andrew Noblet — Design & development"
  description="Brand and interface design, web development, hosting, and practical technical guidance. Work directly with Andrew Noblet to build a clearer digital presence."
>
  <div class="editorial-page">
    <section class="editorial-hero">
      <div class="hero-copy">
        <p class="eyebrow">Independent design & development</p><h1>
          Good ideas.<br />Thoughtfully built.
        </h1><p>
          I help small businesses and teams turn their ideas into clear, useful
          websites and digital experiences. From the first design to deployment,
          you work directly with me.
        </p><div class="editorial-actions">
          <a class="editorial-button" href="/contact"
            >Let’s talk about your project <span aria-hidden="true">→</span></a
          ><a href="/portfolio/professional">Explore my work →</a>
        </div><p class="eyebrow">Design · Development · Technical guidance</p>
      </div>
      <figure>
        <EditorialImage
          src={hero}
          priority
          sizes="(max-width: 760px) calc(100vw - 2rem), 540px"
        />
      </figure>
    </section>
    <section class="editorial-section">
      <div class="section-heading">
        <p class="eyebrow">01 / A useful starting point</p><h2>
          From a clearer identity<br />to a working website.
        </h2><p>
          A project can start with a new brand, an existing website that needs
          attention, or a technical question. We define the work around what
          your audience needs to do.
        </p>
      </div>
      <div class="editorial-grid">
        <Card
          ><p class="eyebrow">01 / Design</p><h3>
            Make the next step feel clear.
          </h3><p>
            Brand identity, page layouts, and interfaces that help people
            understand your business and find what they need.
          </p><a href="/services/design">Explore design services →</a></Card
        >
        <Card
          ><p class="eyebrow">02 / Development & hosting</p><h3>
            Bring the experience to life.
          </h3><p>
            Responsive websites, deployment, and ongoing care. We agree on the
            build and support your project needs before work begins.
          </p><a href="/services/hosting">Explore hosting & deployment →</a
          ></Card
        >
        <Card
          ><p class="eyebrow">03 / Consultation</p><h3>
            Work through a difficult decision.
          </h3><p>
            Get a second perspective on architecture, code, performance, or the
            next phase of a project.
          </p><a href="/services/consultation"
            >Explore technical consultation →</a
          ></Card
        >
        <Card
          ><p class="eyebrow">04 / Local outreach</p><h3>
            Start a useful conversation.
          </h3><p>
            Thoughtful Facebook community-group posts, with your approval and
            help following up on replies.
          </p><a href="/services/social">Explore social media support →</a
          ></Card
        >
      </div>
    </section>
    <section class="editorial-section editorial-split">
      <div class="section-heading">
        <p class="eyebrow">02 / Selected experience</p><h2>
          Work built around<br />real tasks.
        </h2>
      </div>
      <div class="editorial-prose">
        <p>
          My professional work includes online learning at CXL, e-commerce for
          Graduation Source, and product discovery for Avanti Systems USA. Each
          asks a different question about how people find information and take
          action.
        </p><a href="/portfolio/professional">Read about the work →</a><p>
          This website is also a working project: static pages, reusable
          components, and interactive demos brought together with Astro.
        </p><a href="/portfolio/personal">Explore personal projects →</a>
      </div>
    </section>
    <ContactPanel />
  </div>
</Layout>
