---
import Layout from '@layouts/default.astro';
import EditorialImage from '@components/EditorialImage.astro';
import ContactPanel from '@components/ContactPanel.astro';
import Card from '@components/Card.astro';
import hero from '@assets/images/profile.webp';
const home = new URL('/', Astro.site).href;
const person = home + '#andrew-noblet';
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': person,
      name: 'Andrew Noblet',
      url: home,
      jobTitle: 'Software engineer',
    },
    {
      '@type': 'LocalBusiness',
      '@id': home + '#web-services',
      name: 'Andrew Noblet',
      url: new URL('/hosting/', Astro.site).href,
      founder: { '@id': person },
      areaServed: ['Westchester County, New York', 'New York City, New York'],
    },
  ],
};
const primaryAction = 'Book a free 30-minute discovery call';
---

<Layout
  title="Andrew Noblet — Design & development"
  description="Brand and interface design, web development, hosting, and practical technical guidance. Work directly with Andrew Noblet to build a clearer digital presence."
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(schema).replaceAll('<', '\\u003c')}
  />
  <div class="editorial-page">
    <section class="editorial-hero">
      <div class="hero-copy">
        <p class="eyebrow">Web design, development & hosting</p><h1>
          Good ideas. Thoughtfully built.
        </h1><p>
          I’m Andrew, a software engineer with a designer’s eye and a habit of
          making things. I help small businesses and teams turn their ideas into
          clear, useful websites. From the first design to deployment, you work
          directly with me. I serve Westchester County and New York City, and
          offer remote technical consultation across the United States.
        </p><div class="editorial-actions">
          <a class="editorial-button" href="/contact"
            >{primaryAction} <span aria-hidden="true">↗</span></a
          ><a href="/portfolio/professional">Explore my work ↗</a>
        </div>
      </div>
      <figure>
        <EditorialImage
          src={hero}
          alt="Andrew Noblet"
          priority
          sizes="(max-width: 760px) calc(100vw - 2rem), 540px"
        />
        <figcaption>
          Andrew Noblet · Design, code, and a little curiosity.
        </figcaption>
      </figure>
    </section>
    <section class="editorial-section">
      <div class="section-heading">
        <p class="eyebrow">Services</p><h2>
          From a clearer identity to a working website.
        </h2><p>
          A project can start with a new brand, an existing website that needs
          attention, or a technical question. We define the work around what
          your audience needs to do.
        </p>
      </div>
      <div class="editorial-grid">
        <Card
          ><h3>Brand and interface design</h3><p>
            Brand identity, page layouts, and interfaces that help people
            understand your business and find what they need.
          </p><a href="/services/design">Explore design services ↗</a></Card
        >
        <Card
          ><h3>Website development and hosting</h3><p>
            Responsive websites, deployment, and ongoing care. We agree on the
            build and support your project needs before work begins.
          </p><a href="/services/hosting">Explore hosting & deployment ↗</a
          ></Card
        >
        <Card
          ><h3>Technical consultation</h3><p>
            Get a second perspective on architecture, code, performance, or the
            next phase of a project.
          </p><a href="/services/consultation"
            >Explore technical consultation ↗</a
          ></Card
        >
        <Card
          ><h3>Local social media support</h3><p>
            Thoughtful Facebook community-group posts, with your approval and
            help following up on replies.
          </p><a href="/services/social">Explore social media support ↗</a
          ></Card
        >
        <Card>
          <h3>Computer tutoring</h3>
          <p>
            Hands-on lessons in computer basics, Scratch, and beginner Python in
            the Tarrytown area.
          </p>
          <a href="/services/tutoring">Explore computer tutoring ↗</a>
        </Card>
      </div>
    </section>
    <section class="editorial-section editorial-split">
      <div class="section-heading">
        <p class="eyebrow">Selected experience</p><h2>
          Work built around<br />real tasks.
        </h2>
      </div>
      <div class="editorial-prose">
        <p>
          My work includes launching Hudson Valley Smart Home Solutions,
          building learning features at CXL, supporting e-commerce at Graduation
          Source, and improving product discovery at Avanti Systems USA.
        </p><a href="/portfolio/professional">Read about the work ↗</a><p>
          This website is also a working project: static pages, reusable
          components, and interactive demos brought together with Astro.
        </p><a href="/portfolio/personal">Explore personal projects ↗</a>
      </div>
    </section>
    <section class="editorial-section editorial-split">
      <div class="section-heading">
        <p class="eyebrow">About Andrew</p>
        <h2>It started with a website.<br />And a skatepark.</h2>
      </div>
      <div class="editorial-prose">
        <p>
          I built my first website at 13. At 14, I petitioned my town for a
          skatepark. Different projects, same starting point: an idea worth
          doing something about.
        </p>
        <p>
          That curiosity still takes me from web components to 3D printing, home
          automation, and guitar. I like learning how things work and making
          something useful with what I find.
        </p>
        <a href="/about">A little more about me ↗</a>
      </div>
    </section>
    <ContactPanel label={primaryAction} />
  </div>
</Layout>

<style>
  figcaption {
    margin-top: 1rem;
    color: var(--hero-description-color);
    font-size: 0.8rem;
    line-height: 1.6;
  }
</style>
