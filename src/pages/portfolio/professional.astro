---
import Layout from '@layouts/default.astro';
import Card from '@components/Card.astro';
import Tag from '@components/Tag.astro';
import cxl from '@assets/cxl.com_.webp';
import graduationSource from '@assets/graduationsource.com_.webp';
import avantisystemsusa from '@assets/avantisystemsusa.com_.webp';
import ArrowForward from '@icons/arrow-forward.svg';
import { Image } from 'astro:assets';
---

<Layout
  title="Andrew Noblet - Professional"
  description="Professional web development portfolio featuring scalable e-commerce platforms, high-performance applications, and enterprise solutions. Real-world client projects and technical achievements."
>
  <div class="column flex gap page">
    <div class="gap grid justify-content-center text-align-center">
      <h1>Professional</h1>
      <p class="bold-5 max-width-56">
        Explore professional web projects where I've built scalable e-commerce
        platforms, educational systems, and corporate sites—demonstrating
        expertise in modern tech and user-focused solutions.
      </p>
    </div>
    <div class="space-0-5"></div>
    <Card>
      <h2>CXL</h2>
      <Image src={cxl} alt="CXL" class="card-image" />
      <div class="flex-1">
        <ul>
          <li>
            Helped build CXL.com, a top online training platform for B2B
            marketers.
          </li>
          <li>
            Delivered a feature-rich e-learning system with dynamic content,
            user authentication, and subscription e-commerce.
          </li>
          <li>
            Focused on a responsive, high-performance experience for on-demand
            and live courses.
          </li>
        </ul>
      </div>
      <div class="flex flex-wrap gap-0-5 justify-content-center tags">
        <Tag>HTML</Tag>
        <Tag>CSS</Tag>
        <Tag>JavaScript</Tag>
        <Tag>Web Components</Tag>
        <Tag>Lit</Tag>
        <Tag>Wordpress</Tag>
        <Tag>WooCommerce</Tag>
      </div>
      <span></span>
      <a
        class="align-self-flex-end gap-0-5"
        href="https://cxl.com/"
        target="_blank"
        rel="noopener noreferrer"
      >
        Learn more <ArrowForward />
      </a>
    </Card>
    <Card>
      <h2>Graduation Source</h2>
      <Image
        src={graduationSource}
        alt="Graduation Source"
        class="card-image"
      />
      <div class="flex-1">
        <ul>
          <li>
            Built and maintained a robust e-commerce platform for
            GraduationSource, serving 500,000+ graduates annually.
          </li>
          <li>
            Enhanced the product catalog, order management, and user account
            features for a seamless experience.
          </li>
          <li>
            Developed student ordering portals, integrated payment gateways, and
            ensured scalable, high-performance shopping for all education
            levels.
          </li>
        </ul>
      </div>
      <div class="flex flex-wrap gap-0-5 justify-content-center tags">
        <Tag>HTML</Tag>
        <Tag>CSS</Tag>
        <Tag>JS</Tag>
        <Tag>PHP</Tag>
        <Tag>Magento</Tag>
      </div>
      <span></span>
      <a
        class="align-self-flex-end gap-0-5"
        href="https://graduationsource.com/"
        target="_blank"
        rel="noopener noreferrer"
      >
        Learn more <ArrowForward />
      </a>
    </Card>
    <Card>
      <h2>Avanti Systems USA</h2>
      <Image
        src={avantisystemsusa}
        alt="Avanti Systems USA"
        class="card-image"
      />
      <div class="flex-1">
        <ul>
          <li>
            Built a modern web presence for Avanti Systems USA, a leader in
            commercial glass wall systems.
          </li>
          <li>
            Designed a visually engaging platform to showcase diverse product
            lines—frameless, freestanding, and high wall systems.
          </li>
          <li>
            Delivered intuitive navigation and information architecture for
            architects, designers, and contractors.
          </li>
          <li>
            Integrated robust product galleries, detailed specs, and lead
            generation forms to boost engagement.
          </li>
          <li>
            Prioritized responsive design and easy content management for
            featured projects and the company blog.
          </li>
        </ul>
      </div>
      <div class="flex flex-wrap gap-0-5 justify-content-center tags">
        <Tag>HTML</Tag>
        <Tag>CSS</Tag>
        <Tag>JavaScript</Tag>
        <Tag>Wordpress</Tag>
      </div>
      <span></span>
      <a
        class="align-self-flex-end gap-0-5"
        href="https://avantisystemsusa.com/"
        target="_blank"
        rel="noopener noreferrer"
      >
        Learn more <ArrowForward />
      </a>
    </Card>
  </div>
</Layout>
<style>
  .card-image {
    border-radius: 0.25rem;
    height: 100%;
    width: 100%;
  }
</style>
