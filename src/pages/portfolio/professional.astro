---
import Layout from '@layouts/default.astro';
import ContactPanel from '@components/ContactPanel.astro';
import { Image } from 'astro:assets';
import { work } from '../../data/work';
---

<Layout
  title="Professional work — Andrew Noblet"
  description="Selected work in online learning, e-commerce, and product discovery, with Andrew Noblet’s role and contributions."
>
  <div class="editorial-page">
    <section class="editorial-section">
      <div class="section-heading">
        <p class="eyebrow">Selected professional work</p><h1
          class="editorial-title"
        >
          Different businesses.<br />Useful experiences.
        </h1><p>
          A selection of projects I have contributed to, with a closer look at
          my role and the work involved.
        </p>
      </div>
    </section>
    {
      work.map((project, index) => (
        <article class="editorial-section editorial-split">
          <>
            <a
              href={`/portfolio/work/${project.id}`}
              aria-label={`Read about ${project.name}`}
            >
              <Image
                src={project.image}
                alt={`${project.name} website screenshot`}
                widths={[400, 800, 1200]}
                sizes="(max-width: 760px) calc(100vw - 2rem), 500px"
                loading="lazy"
              />
            </a>
            <div class="editorial-prose">
              <>
                <p class="eyebrow">
                  0{index + 1} / {project.category}
                </p>
                <h2>{project.name}</h2>
                <p>{project.description}</p>
                <p>{project.role}</p>
                <a href={`/portfolio/work/${project.id}`}>
                  Read about the work →
                </a>
                <a href={project.url}>Visit website →</a>
              </>
            </div>
          </>
        </article>
      ))
    }
    <ContactPanel />
  </div>
</Layout>
<style>
  article img {
    width: 100%;
    height: auto;
    border-radius: 0.5rem;
    border: 1px solid var(--card-border-color);
  }
</style>
