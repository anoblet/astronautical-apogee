---
import Layout from '@layouts/default.astro';
import ContactPanel from '@components/ContactPanel.astro';
import { Image } from 'astro:assets';
import { work } from '../../../data/work';
export function getStaticPaths() {
  return work.map(project => ({
    params: { id: project.id },
    props: { project },
  }));
}
const { project } = Astro.props;
---

<Layout
  title={`${project.name} — Work by Andrew Noblet`}
  description={project.description}
>
  <article class="editorial-page">
    <section class="editorial-section">
      <a href="/portfolio/professional">← All professional work</a><div
        class="section-heading"
      >
        <p class="eyebrow">{project.category}</p><h1 class="editorial-title">
          {project.name}
        </h1><p>{project.description}</p>
      </div><Image
        src={project.image}
        alt={`${project.name} website screenshot`}
        widths={[400, 800, 1200]}
        sizes="(max-width: 1160px) calc(100vw - 2rem), 1160px"
        loading="eager"
      />
    </section>
    <section class="editorial-section editorial-split">
      <h2>The project</h2><div class="editorial-prose">
        <p>{project.context}</p><h3>My role</h3><p>{project.role}</p>
      </div>
    </section>
    <section class="editorial-section editorial-split">
      <h2>The work</h2><div class="editorial-prose">
        <ul>{project.contributions.map(item => <li>{item}</li>)}</ul><p>
          {project.focus}
        </p><h3>Technologies</h3><p>{project.technologies.join(' · ')}</p><p>
          This describes my contributions to the project. The current client
          website may have changed since that work.
        </p><a href={project.url}>Visit {project.name} →</a>
      </div>
    </section>
    <ContactPanel title="Have a related challenge?" />
  </article>
</Layout>
<style>
  article img {
    width: 100%;
    height: auto;
    border-radius: 0.5rem;
  }
</style>
