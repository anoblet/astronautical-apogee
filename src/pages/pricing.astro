---
import PricingNavigation from '@components/PricingNavigation.astro';
import PackageExpectations from '@components/PackageExpectations.astro';
import Layout from '@layouts/default.astro';
import PricingCard from '@components/PricingCard.astro';
---

<Layout
  title="Website pricing — Andrew Noblet"
  description="Transparent pricing for web development services. Choose from flexible plans that include direct collaboration, modern web technologies, and ongoing support. Get started today."
>
  <h1 class="text-align-center pricing-heading margin-bottom-2">
    Website pricing
  </h1>
  <p
    class="hero-description text-align-center margin-bottom-4 max-width-48 margin-auto"
  >
    Compare one-time website builds below, or choose a service to see its
    packages and billing options.
  </p>

  <PricingNavigation />
  <h2 class="text-align-center">Website packages</h2>
  <p class="text-align-center margin-bottom-2">
    One-time builds for a new launch or your next stage of growth.
  </p>
  <div class="grid auto-fit-20 gap-2 width-100 max-width-64 margin-auto">
    <PricingCard
      title="Basic"
      description="A single-page website for launching a business or introducing a service."
      features={[
        'Single-page site',
        'Responsive design',
        'Basic SEO',
        'Email support',
      ]}
      price="$999 one-time"
      buttonText="Discuss on a free call"
      buttonHref="/contact"
    />
    <PricingCard
      title="Pro"
      description="A multi-page website for businesses that need custom integrations."
      features={[
        'Multi-page site',
        'Custom integrations',
        'Performance optimization',
        'Priority support',
      ]}
      price="$2,499 one-time"
      buttonText="Discuss on a free call"
      buttonHref="/contact"
    />
  </div>
  <p class="max-width-48">
    These are website build packages. <a href="/services/design/pricing"
      >Design-only packages</a
    > start at $499. We confirm which design work, integrations, and support are
    included in your website proposal, including how long support lasts and expected
    response times.
  </p>
  <PackageExpectations />
</Layout>
