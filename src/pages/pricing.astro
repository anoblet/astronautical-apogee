---
import CallToAction from '@components/CallToAction.astro';
import Layout from '@layouts/default.astro';
import PricingCard from '@components/PricingCard.astro';
---

<Layout
  title="Pricing"
  description="Transparent pricing for web development services. Choose from flexible plans that include direct collaboration, modern web technologies, and ongoing support. Get started today."
>
  <h1 class="text-align-center font-size-2 margin-bottom-2">Pricing</h1>
  <p
    class="hero-description text-align-center margin-bottom-4 max-width-48 margin-auto"
  >
    Select the plan that suits your goals. Every plan includes direct
    collaboration, modern web technologies, and ongoing support.
  </p>

  <div class="pricing-links flex gap-2 justify-center margin-bottom-4">
    <CallToAction href="/services/hosting/pricing">
      Hosting Pricing
    </CallToAction>
    <CallToAction href="/services/design/pricing">
      Design Pricing
    </CallToAction>
    <CallToAction href="/services/consultation/pricing">
      Consultation Pricing
    </CallToAction>
    <CallToAction href="/services/community-social/pricing">
      Social Media Pricing
    </CallToAction>
  </div>
  <div class="grid auto-fit-20 gap-2 width-100 max-width-64 margin-auto">
    <PricingCard
      title="Basic"
      description="Perfect for individuals and startups to launch a professional web presence."
      features={[
        'Single-page site',
        'Responsive design',
        'Basic SEO',
        'Email support',
      ]}
      price="$999"
      buttonText="Get Started"
      buttonHref="/contact"
    />
    <PricingCard
      title="Pro"
      description="Designed for growing businesses needing advanced features and integrations."
      features={[
        'Multi-page site',
        'Custom integrations',
        'Performance optimization',
        'Priority support',
      ]}
      price="$2,499"
      buttonText="Get Started"
      buttonHref="/contact"
    />
  </div>
</Layout>

<style>
  .pricing-links {
    flex-wrap: wrap;
  }
</style>
