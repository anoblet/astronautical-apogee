---
import PricingNavigation from '@components/PricingNavigation.astro';
import PackageExpectations from '@components/PackageExpectations.astro';
import Layout from '@layouts/default.astro';
import PricingCard from '@components/PricingCard.astro';
---

<Layout
  title="Pricing"
  description="Transparent pricing for web development services. Choose from flexible plans that include direct collaboration, modern web technologies, and ongoing support. Get started today."
>
  <h1 class="text-align-center font-size-2 margin-bottom-2">Pricing</h1>
  <p
    class="hero-description text-align-center margin-bottom-4 max-width-48 margin-auto"
  >
    Find the right support for your next step, from a new website to ongoing
    hosting. Choose a service to compare packages and billing options.
  </p>

  <PricingNavigation />
  <h2 class="text-align-center">Website packages</h2>
  <p class="text-align-center margin-bottom-2">
    One-time builds for a new launch or your next stage of growth.
  </p>
  <div class="grid auto-fit-20 gap-2 width-100 max-width-64 margin-auto">
    <PricingCard
      title="Basic"
      description="Perfect for individuals and startups to launch a professional web presence."
      features={[
        'Single-page site',
        'Responsive design',
        'Basic SEO',
        'Email support',
      ]}
      price="$999 one-time"
      buttonText="Get Started"
      buttonHref="/contact"
    />
    <PricingCard
      title="Pro"
      description="Designed for growing businesses needing advanced features and integrations."
      features={[
        'Multi-page site',
        'Custom integrations',
        'Performance optimization',
        'Priority support',
      ]}
      price="$2,499 one-time"
      buttonText="Get Started"
      buttonHref="/contact"
    />
  </div>
  <p class="max-width-48">
    These are website build packages. <a href="/services/design/pricing"
      >Design-only packages</a
    > start at $499. We confirm which design work, integrations, and support are
    included in your website proposal.
  </p>
  <PackageExpectations />
</Layout>
