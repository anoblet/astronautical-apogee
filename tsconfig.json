{
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@assets/*": [
                "src/assets/*"
            ],
            "@components/*": [
                "src/components/*"
            ],
            "@icons/*": [
                "src/icons/*"
            ],
            "@layouts/*": [
                "src/layouts/*"
            ],
            "@mixins/*": [
                "src/mixins/*"
            ],
            "@styles/*": [
                "src/styles/*"
            ],
            "@themes/*": [
                "src/themes/*"
            ],
            "@utility/*": [
                "src/utility/*"
            ]
        },
        "experimentalDecorators": true,
        "target": "es2022",
        "useDefineForClassFields": false
    },
    "extends": "astro/tsconfigs/strict",
    "include": [
        ".astro/types.d.ts",
        "**/*"
    ],
    "exclude": [
        "dist"
    ]
}
